/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @NModuleScope SameAccount
 *
 * GYH_BuildableOrders_SL
 * ----------------------------------------------------------------------------
 * Shows open, unshipped sales orders at the GEN-Y HITCH location and answers:
 *   "Can we build this right now, and if not, why not?"
 *
 * RENDERING CONTRACT (do not change without reading this):
 *   The whole dashboard is delivered as a SINGLE INLINEHTML field on a
 *   serverWidget Form, rendered with response.writePage(). This keeps the
 *   NetSuite header, role switcher and navigation intact. Do NOT switch back to
 *   response.write() with raw HTML -- that produces a bare page with no chrome.
 *
 *   All markup lives inside #gyh-bo. Every CSS rule and every JS symbol is
 *   scoped to that wrapper (JS via the single global GYHBO) so nothing leaks
 *   onto, or collides with, the surrounding NetSuite page. No <html>, <head> or
 *   <body> tags -- NetSuite supplies those.
 *
 * Design decisions (confirmed with Lamar, Aug 2026):
 *   - Location scope ....... location ID 1 (GEN-Y HITCH) ONLY. Child locations
 *                           (Powdercoat, Amazon DC, OFFSITE vendors) excluded.
 *   - Past due ............. trandate + category lead days < today
 *   - Buildability ......... order-level rollup with line-level drill-down
 *   - Competing demand ..... netted. Supply is allocated across orders in due
 *                           date order (earliest first), so the same 42 units
 *                           cannot be promised to three different orders.
 *   - NULL max_buildable ... treated as ZERO / not buildable
 *   - Stock first .......... on-hand available is consumed before build capacity
 *   - WO signal ............ open WOs filtered to custbody_gyh_traveler_printed='T'
 *                           (the job traveler stamp field). Reports presence and
 *                           quantity, NOT a promised date -- see note below.
 *
 * KNOWN DATA CAVEATS (surfaced during build, verified against prod):
 *   1. inventoryitemlocations.quantityavailable is stale account-wide and returns
 *      0 for every item. inventorybalance is the live table. Do not "optimize"
 *      this back to inventoryitemlocations.
 *   2. 7,049 of 12,802 active assemblies have a NULL custitem_gny_max_buildable.
 *      Per decision these count as zero, so the on-hand check carries most of the
 *      weight. If that job ever gets fixed, this report gets much sharper.
 *   3. 92% of open work orders have an enddate in the past (avg 18 days over for
 *      printed WOs). The WO column therefore does NOT promise a completion date.
 *      Showing enddate as an ETA would be actively misleading.
 */

define(['N/query', 'N/ui/serverWidget', 'N/log', 'N/runtime'], function (query, serverWidget, log, runtime) {

    // ---------------------------------------------------------------- config

    var HITCH_LOCATION = 1;
    var ACCOUNT_ID     = '5262266';
    var WRAP           = 'gyh-bo';   // single wrapper id -- everything scopes to this

    // Lead time in days by customer category ID. Source: Lamar, Aug 2026.
    // Key 0 = customer record has no category set.
    var LEAD_DAYS = {
        0: 10,   // (no category set)
        1: 10,   // National Distribution
        2: 10,   // E-Commerce Wholesale
        4: 10,   // Master Dealer
        5: 5,    // Inside Sales
        6: 5,    // GEN-Y US Web Orders
        7: 5,    // GEN-Y CDN Web Orders
        8: 5,    // Amazon US
        9: 5,    // AMAZON-CAN
        10: 5,   // Ebay-US
        11: 10,  // Standard Dealer
        13: 10,  // Regional Distribution
        14: 5,   // Jobber/Fleet
        15: 15,  // Manufacturer/OEM
        16: 15,  // Sponsor Account
        17: 10,  // Canada
        18: 5,   // Not Specified
        21: 0,   // GEN-Y WEB-US -IA
        22: 10,  // Inter Company
        23: 10,  // Chile
        24: 10,  // United Kingdom
        25: 10,  // Box Store
        26: 5,   // Walmart
        29: 30,  // International Distributor
        30: 5,   // TikTok
        31: 10   // Canada Distributor
    };
    var DEFAULT_LEAD_DAYS = 10;

    /**
     * Builds a status predicate that matches BOTH status formats.
     *
     * This is the single nastiest portability trap in this script. SuiteQL run
     * through the REST/SuiteTalk endpoint returns transaction status as the bare
     * code ('B'). SuiteQL run through N/query inside a Suitelet returns it
     * PREFIXED with the transaction type ('SalesOrd:B', 'WorkOrd:B').
     *
     * A filter written for one form silently matches NOTHING in the other -- no
     * error, no warning, just an empty report. Always filter through this helper.
     */
    function statusIn(col, type, codes) {
        var vals = [];
        codes.forEach(function (c) {
            vals.push("'" + c + "'");                 // bare form:    B
            vals.push("'" + type + ":" + c + "'");    // prefixed form: SalesOrd:B
        });
        return '(' + col + ' IN (' + vals.join(',') + '))';
    }

    var SO_OPEN = ['A', 'B', 'D', 'E'];   // Pending Approval, Pending Fulfillment,
                                          // Partially Fulfilled, Pending Billing/Part Fulfilled
    var WO_OPEN = ['A', 'B', 'D'];        // Planned, Released, In Process

    /**
     * Customer type tabs. Maps customer category ID -> tab key.
     * Any category not listed falls to UNASSIGNED, as does a customer record with
     * no category set at all (cat_id 0).
     */
    var TAB_OF_CATEGORY = {
        // Retail / direct-to-consumer / marketplace
        5:  'RETAIL',   // Inside Sales
        6:  'RETAIL',   // GEN-Y US Web Orders
        7:  'RETAIL',   // GEN-Y CDN Web Orders
        8:  'RETAIL',   // Amazon US
        9:  'RETAIL',   // AMAZON-CAN
        10: 'RETAIL',   // Ebay-US
        21: 'RETAIL',   // GEN-Y WEB-US -IA
        25: 'RETAIL',   // Box Store
        26: 'RETAIL',   // Walmart
        30: 'RETAIL',   // TikTok

        // OEM / manufacturers building us into their product
        15: 'OEM',      // Manufacturer/OEM
        16: 'OEM',      // Sponsor Account
        22: 'OEM',      // Inter Company

        // Wholesale / distribution / dealer network
        1:  'WHOLESALE',  // National Distribution
        2:  'WHOLESALE',  // E-Commerce Wholesale
        4:  'WHOLESALE',  // Master Dealer
        11: 'WHOLESALE',  // Standard Dealer
        13: 'WHOLESALE',  // Regional Distribution
        14: 'WHOLESALE',  // Jobber/Fleet
        17: 'WHOLESALE',  // Canada
        18: 'WHOLESALE',  // Not Specified
        23: 'WHOLESALE',  // Chile
        24: 'WHOLESALE',  // United Kingdom
        28: 'WHOLESALE',  // House Account
        29: 'WHOLESALE',  // International Distributor
        31: 'WHOLESALE'   // Canada Distributor
    };

    // Order matters -- this is left-to-right tab order.
    // UNASSIGNED renders only when it actually has orders, so in normal operation
    // this is a three-tab report as specified.
    var TABS = [
        { key: 'RETAIL',     label: 'Retail' },
        { key: 'OEM',        label: 'OEM' },
        { key: 'WHOLESALE',  label: 'Wholesale' },
        { key: 'UNASSIGNED', label: 'Unassigned', onlyIfPopulated: true }
    ];

    function tabForCategory(catId) {
        return TAB_OF_CATEGORY[catId] || 'UNASSIGNED';
    }

    var STATUS = {
        SHIP:    { key: 'SHIP',    label: 'Ship now',  rank: 0, css: 'st-ship'  },
        BUILD:   { key: 'BUILD',   label: 'Build now', rank: 1, css: 'st-build' },
        PARTIAL: { key: 'PARTIAL', label: 'Partial',   rank: 2, css: 'st-part'  },
        WO:      { key: 'WO',      label: 'On a WO',   rank: 3, css: 'st-wo'    },
        BLOCKED: { key: 'BLOCKED', label: 'Blocked',   rank: 4, css: 'st-block' }
    };

    // ----------------------------------------------------------------- utils

    function esc(v) {
        if (v === null || v === undefined) return '';
        return String(v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function num(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }

    function parseNsDate(s) {
        // NetSuite SuiteQL returns MM/DD/YYYY
        if (!s) return null;
        var p = String(s).split('/');
        if (p.length !== 3) return null;
        return new Date(parseInt(p[2], 10), parseInt(p[0], 10) - 1, parseInt(p[1], 10));
    }

    function addDays(d, n) {
        var r = new Date(d.getTime());
        r.setDate(r.getDate() + n);
        return r;
    }

    function fmtDate(d) {
        if (!d) return '';
        return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
    }

    function daysBetween(a, b) {
        return Math.round((b.getTime() - a.getTime()) / 86400000);
    }

    /**
     * Order notes are free text and run long (some are multi-sentence updates
     * from the sales team). The row shows a clipped preview with the full text on
     * hover; the drill-down still shows it in full.
     */
    function clip(txt, max) {
        var t = String(txt || '').replace(/\s+/g, ' ').trim();
        if (!t) return '';
        return (t.length <= max) ? t : t.substring(0, max - 1) + '\u2026';
    }

    function soUrl(id) {
        return '/app/accounting/transactions/salesord.nl?id=' + id;
    }

    function woUrl(id) {
        return '/app/accounting/transactions/workord.nl?id=' + id;
    }

    function itemUrl(id) {
        return '/app/common/item/item.nl?id=' + id;
    }

    // ------------------------------------------------------------- data pull

    /**
     * Open, unshipped SO lines at the hitch location.
     * One row per SO line. Header data repeats -- grouped in JS.
     */
    function fetchOpenLines() {
        var sql =
            "SELECT " +
            "  t.id                AS so_id, " +
            "  t.tranid            AS so_num, " +
            "  t.trandate          AS tran_date, " +
            "  t.status            AS so_status, " +
            "  t.custbody_ordernotes AS order_notes, " +
            "  c.id                AS cust_id, " +
            "  c.entityid          AS cust_num, " +
            // companyname is NULL on person-type customers (their name lives in
            // altname), so fall through to it. Parent is pulled separately so a
            // subcustomer shows which account it belongs to.
            "  NVL(c.companyname, c.altname) AS cust_name, " +
            "  NVL(p.companyname, p.altname) AS parent_name, " +
            "  NVL(c.category, 0)  AS cat_id, " +
            "  tl.uniquekey        AS line_id, " +   // tl.id is the per-order line index, NOT unique
            "  tl.linesequencenumber AS line_seq, " +
            "  tl.memo             AS line_memo, " +
            "  i.id                AS item_id, " +
            "  i.itemid            AS item_name, " +
            "  i.itemtype          AS item_type, " +
            "  ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) AS qty_open, " +
            "  NVL(i.custitem_gny_max_buildable, 0) AS max_build, " +
            "  NVL(ib.avail, 0)    AS qty_avail, " +
            "  NVL(ib.onhand, 0)   AS qty_onhand, " +
            "  tlm.expectedshipdate AS exp_ship " +
            "FROM transaction t " +
            "JOIN customer c ON c.id = t.entity " +
            "LEFT JOIN customer p ON p.id = c.parent " +
            "JOIN transactionline tl ON tl.transaction = t.id " +
            "JOIN item i ON i.id = tl.item " +
            "LEFT JOIN ( " +
            "   SELECT item, SUM(quantityonhand) AS onhand, SUM(quantityavailable) AS avail " +
            "   FROM inventorybalance WHERE location = " + HITCH_LOCATION + " GROUP BY item " +
            ") ib ON ib.item = tl.item " +
            // Real ship date lives on the MAINLINE row. transaction.enddate is
            // null account-wide, so do not reach for it.
            "LEFT JOIN transactionline tlm ON tlm.transaction = t.id AND tlm.mainline = 'T' " +
            "WHERE t.type = 'SalesOrd' " +
            "  AND " + statusIn('t.status', 'SalesOrd', SO_OPEN) + " " +
            "  AND tl.mainline = 'F' " +
            "  AND tl.location = " + HITCH_LOCATION + " " +
            "  AND tl.isclosed = 'F' " +
            "  AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
            "  AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0 " +
            "ORDER BY t.trandate, t.tranid, tl.linesequencenumber";

        return query.runSuiteQL({ query: sql }).asMappedResults();
    }

    /**
     * Open work orders with a PRINTED job traveler, aggregated per item.
     * Unprinted and null-printed WOs are excluded: the 538 null-printed WOs
     * average 191 days open and are effectively abandoned.
     */
    function fetchPrintedWos() {
        var sql =
            "SELECT " +
            "  wl.item             AS item_id, " +
            "  COUNT(*)            AS wo_count, " +
            "  SUM(ABS(NVL(wl.quantity,0))) AS wo_qty, " +
            "  MIN(w.enddate)      AS earliest_end, " +
            "  MAX(w.enddate)      AS latest_end " +
            "FROM transaction w " +
            "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
            "WHERE w.type = 'WorkOrd' " +
            "  AND " + statusIn('w.status', 'WorkOrd', WO_OPEN) + " " +
            "  AND w.custbody_gyh_traveler_printed = 'T' " +
            "GROUP BY wl.item";

        var map = {};
        query.runSuiteQL({ query: sql }).asMappedResults().forEach(function (r) {
            map[r.item_id] = {
                count: num(r.wo_count),
                qty: num(r.wo_qty),
                earliest: r.earliest_end,
                latest: r.latest_end
            };
        });
        return map;
    }

    // ----------------------------------------------------------- diagnostics

    /**
     * Runs a ladder of progressively narrower queries. The first row that drops
     * to zero names the predicate that is killing the report. Run this by adding
     * &debug=T to the Suitelet URL.
     *
     * This exists because SuiteQL run through an integration role and SuiteQL run
     * inside a Suitelet do NOT always see the same rows -- role permissions,
     * subsidiary restrictions and feature access all apply at query time.
     */
    function runProbes() {
        var probes = [
            ['1. any transaction row',
             "SELECT COUNT(*) AS n FROM transaction"],

            ['2. sales orders',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd'"],

            ['3. + open status A/B/D/E',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND " + statusIn('status', 'SalesOrd', SO_OPEN)],

            ['3b. status format check (bare codes)',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND status IN ('A','B','D','E')"],

            ['3c. status format check (prefixed codes)',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND status IN ('SalesOrd:A','SalesOrd:B','SalesOrd:D','SalesOrd:E')"],

            ['4. + joined to lines',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " AND tl.mainline = 'F'"],

            ['5. + location = ' + HITCH_LOCATION,
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location = " + HITCH_LOCATION],

            ['6. + line open and item type',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location = " + HITCH_LOCATION + " " +
             "AND tl.isclosed = 'F' AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
             "AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0"],

            ['7. + join customer',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN customer c ON c.id = t.entity " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location = " + HITCH_LOCATION],

            ['8. + join item',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "JOIN item i ON i.id = tl.item " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location = " + HITCH_LOCATION],

            ['9. inventorybalance readable',
             "SELECT COUNT(*) AS n FROM inventorybalance WHERE location = " + HITCH_LOCATION],

            ['10. item.custitem_gny_max_buildable readable',
             "SELECT COUNT(*) AS n FROM item WHERE custitem_gny_max_buildable IS NOT NULL"],

            ['11. transaction.custbody_ordernotes readable',
             "SELECT COUNT(*) AS n FROM transaction WHERE custbody_ordernotes IS NOT NULL"],

            ['12. WO printed flag readable',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'WorkOrd' " +
             "AND custbody_gyh_traveler_printed = 'T'"],

            ['13. FULL production query',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN customer c ON c.id = t.entity " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "JOIN item i ON i.id = tl.item " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location = " + HITCH_LOCATION + " " +
             "AND tl.isclosed = 'F' AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
             "AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0"]
        ];

        return probes.map(function (p) {
            var out = { label: p[0], count: null, error: null };
            try {
                var res = query.runSuiteQL({ query: p[1] }).asMappedResults();
                out.count = (res && res.length) ? num(res[0].n) : 0;
            } catch (e) {
                out.error = e.message || String(e);
            }
            log.audit({ title: 'PROBE ' + p[0], details: out.error ? ('ERROR: ' + out.error) : out.count });
            return out;
        });
    }

    function renderDebug(probes, ctxInfo) {
        var h = renderStyles();
        h += '<div id="' + WRAP + '">';
        h += '<div class="hd">Buildable Orders &mdash; Diagnostics</div>';
        h += '<div class="sub">The first step that returns 0 is the one breaking the report. ' +
             'Remove &amp;debug=T from the URL to return to the dashboard.</div>';

        h += '<div class="warn"><b>Execution context:</b> ' + esc(ctxInfo) + '</div>';

        h += '<table class="grid"><tr><th>Step</th><th>Rows</th><th>Result</th></tr>';
        probes.forEach(function (p) {
            var cell, pill;
            if (p.error) {
                cell = '<span class="late">error</span>';
                pill = '<span class="pill st-block">' + esc(p.error) + '</span>';
            } else if (p.count === 0) {
                cell = '<span class="late">0</span>';
                pill = '<span class="pill st-block">returns nothing</span>';
            } else {
                cell = p.count;
                pill = '<span class="pill st-ship">ok</span>';
            }
            h += '<tr><td>' + esc(p.label) + '</td><td>' + cell + '</td><td>' + pill + '</td></tr>';
        });
        h += '</table></div>';
        return h;
    }

    // --------------------------------------------------------- core analysis

    /**
     * Groups lines into orders, computes due dates, then allocates scarce supply
     * across orders in due-date order.
     *
     * The allocation pass is the whole point of this tool. max_buildable is a
     * per-item cached number that has no idea other orders exist, so three orders
     * for 100 units each will all show "buildable" against a pool of 42. Here the
     * pool is drawn down as it is consumed.
     */
    function buildModel(rows, woMap) {
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        var orders = {};
        var lines = [];

        rows.forEach(function (r) {
            var soId = String(r.so_id);

            if (!orders[soId]) {
                var td = parseNsDate(r.tran_date);
                var lead = LEAD_DAYS.hasOwnProperty(r.cat_id)
                    ? LEAD_DAYS[r.cat_id]
                    : DEFAULT_LEAD_DAYS;
                var due = td ? addDays(td, lead) : null;
                var dueSource = 'derived';

                // OEM orders carry a real scheduled ship date on the mainline row,
                // so use it instead of trandate + category lead time. Everything
                // else has no such date and stays on the derived calculation.
                //
                // custbody_promisedate is deliberately NOT used: it is a rigid
                // trandate+4 on 119 of 122 OEM orders and has corrupt values on 3,
                // so it carries no real scheduling intent.
                var tabKey = tabForCategory(r.cat_id);
                if (tabKey === 'OEM') {
                    var actual = parseNsDate(r.exp_ship);
                    if (actual) {
                        due = actual;
                        dueSource = 'actual';
                    }
                }

                orders[soId] = {
                    id: r.so_id,
                    num: r.so_num,
                    tranDate: td,
                    dueDate: due,
                    dueSource: dueSource,
                    leadDays: lead,
                    catId: r.cat_id,
                    tab: tabKey,
                    daysLate: due ? daysBetween(due, today) : 0,
                    custNum: r.cust_num,
                    custName: r.cust_name || r.cust_num,
                    parentName: r.parent_name || '',
                    notes: r.order_notes || '',
                    soStatus: r.so_status,
                    lines: []
                };
            }

            var line = {
                soId: soId,
                lineId: r.line_id,
                seq: r.line_seq,
                itemId: r.item_id,
                itemName: r.item_name,
                memo: r.line_memo || '',
                qtyOpen: num(r.qty_open),
                maxBuild: num(r.max_build),
                qtyAvail: num(r.qty_avail),
                qtyOnHand: num(r.qty_onhand),
                fromStock: 0,
                fromBuild: 0,
                shortfall: 0,
                status: STATUS.BLOCKED,
                wo: woMap[r.item_id] || null
            };

            orders[soId].lines.push(line);
            lines.push(line);
        });

        // Sort lines by their order's due date so the most urgent order draws
        // from the shared pool first. Ties break on SO number for stability --
        // otherwise identical due dates would allocate in arbitrary query order.
        lines.sort(function (a, b) {
            var oa = orders[a.soId], ob = orders[b.soId];
            var da = oa.dueDate, db = ob.dueDate;
            if (da && db && da.getTime() !== db.getTime()) return da.getTime() - db.getTime();
            if (!da && db) return 1;
            if (da && !db) return -1;
            return String(oa.num).localeCompare(String(ob.num));
        });

        // Per-item supply pools, consumed as we walk the sorted lines.
        var stockPool = {};
        var buildPool = {};

        lines.forEach(function (ln) {
            if (!stockPool.hasOwnProperty(ln.itemId)) stockPool[ln.itemId] = ln.qtyAvail;
            if (!buildPool.hasOwnProperty(ln.itemId)) buildPool[ln.itemId] = ln.maxBuild;

            var need = ln.qtyOpen;

            // Stock first -- a finished unit on the shelf beats build capacity.
            var takeStock = Math.min(need, stockPool[ln.itemId]);
            stockPool[ln.itemId] -= takeStock;
            ln.fromStock = takeStock;
            need -= takeStock;

            // Then build capacity, netted against everything already promised.
            var takeBuild = Math.min(need, buildPool[ln.itemId]);
            buildPool[ln.itemId] -= takeBuild;
            ln.fromBuild = takeBuild;
            need -= takeBuild;

            ln.shortfall = need;

            if (need <= 0) {
                ln.status = (ln.fromBuild > 0) ? STATUS.BUILD : STATUS.SHIP;
            } else if (ln.fromStock > 0 || ln.fromBuild > 0) {
                ln.status = STATUS.PARTIAL;
            } else if (ln.wo && ln.wo.qty > 0) {
                ln.status = STATUS.WO;
            } else {
                ln.status = STATUS.BLOCKED;
            }
        });

        // Order rollup = worst line on the order.
        var list = [];
        Object.keys(orders).forEach(function (k) {
            var o = orders[k];
            var worst = STATUS.SHIP;
            var blocked = 0;
            o.lines.forEach(function (ln) {
                if (ln.status.rank > worst.rank) worst = ln.status;
                if (ln.status.rank >= STATUS.PARTIAL.rank) blocked++;
            });
            o.status = worst;
            o.blockedLines = blocked;
            list.push(o);
        });

        // Most urgent first.
        list.sort(function (a, b) {
            if (b.daysLate !== a.daysLate) return b.daysLate - a.daysLate;
            return String(a.num).localeCompare(String(b.num));
        });

        return list;
    }

