    /**
     * Compact notes indicator for the main grid.
     *
     * The full note text now lives in the expanded view, but hiding it entirely
     * would mean expanding rows blindly to find out which orders have a "why".
     * These pips say what exists and hover shows the newest line, so the board
     * stays scannable without carrying two columns of prose.
     */
    function renderNotePips(o) {
        var bits = [];

        if (o.notes) {
            bits.push('<span class="pip p-ord" title="' + esc(clip(o.notes, 220)) + '">note</span>');
        }

        if (o.stickies.length) {
            var newest = o.stickies[0];
            var lead = newest.replies.length ? newest.replies[0] : newest;
            var high = false;
            o.stickies.forEach(function (n) { if (n.priority === 'High') high = true; });

            bits.push('<span class="pip p-sticky' + (high ? ' p-high' : '') + '" title="' +
                esc(newest.date + ' - ' + clip(stickyPlain(lead.msg), 200)) + '">' +
                (o.stickies.length > 1 ? o.stickies.length + ' sticky' : 'sticky') +
                '</span>');
        }

        return bits.length ? bits.join('') : '<span class="nonote">&mdash;</span>';
    }

    /**
     * Drill-down: the whole thread, newest note first, replies nested under each.
     */
    function renderStickyThread(o) {
        if (!o.stickies.length) return '';

        var h = '<div class="sthread"><b>Sticky notes</b>';
        o.stickies.forEach(function (n) {
            h += '<div class="snote' + (n.priority === 'High' ? ' s-high' : '') + '">' +
                 '<div class="smeta">' + esc(n.date) +
                 (n.priority ? ' &middot; ' + esc(n.priority) : '') +
                 (n.isPublic ? '' : ' &middot; <span class="spriv">private</span>') +
                 '</div>' +
                 '<div class="sbody">' + stickyHtml(n.msg) + '</div>';

            n.replies.forEach(function (rp) {
                h += '<div class="sreply">' +
                     '<div class="smeta">' + esc(rp.date) + ' &middot; reply</div>' +
                     '<div class="sbody">' + stickyHtml(rp.msg) + '</div>' +
                     '</div>';
            });
            h += '</div>';
        });
        return h + '</div>';
    }

    /**
     * Inline note composer, one per expanded order. Collapsed to a single button
     * until used so it does not compete with the data.
     */
    function renderComposer(o) {
        var id = o.id;
        return '<div class="composer" data-so="' + id + '">' +
            '<button type="button" class="cbtn" data-act="open">+ Write a sticky note</button>' +
            '<div class="cform" hidden>' +
                '<textarea class="cmsg" rows="3" maxlength="4000" ' +
                    'placeholder="Note for this order&#10;Enter for a new line"></textarea>' +
                '<div class="crow">' +
                    '<label class="clab">Priority</label>' +
                    '<select class="cpri">' +
                        '<option value="2" selected>Normal</option>' +
                        '<option value="1">High</option>' +
                        '<option value="3">Low</option>' +
                    '</select>' +
                    '<label class="chk"><input type="checkbox" class="cpub" checked> ' +
                        '<span>Visible to everyone</span></label>' +
                    '<span class="cspace"></span>' +
                    '<button type="button" class="cbtn ghost" data-act="cancel">Cancel</button>' +
                    '<button type="button" class="cbtn primary" data-act="save">Save note</button>' +
                '</div>' +
                '<div class="cmsgbox" hidden></div>' +
            '</div>' +
            '</div>';
    }

    /**
     * Line table for the drill-down.
     *
     * The supply meter is the point of this view: one proportional bar per line
     * showing how the demand is covered -- green from stock on the shelf, blue
     * from remaining build capacity, red not covered at all. Because capacity is
     * netted across orders before this renders, a red segment means the parts are
     * genuinely spoken for by an earlier-due order, not merely "low".
     */
    function renderLineTable(o) {
        var h = '<table class="inner"><tr>' +
            '<th>Item</th><th>Need</th><th>Coverage</th>' +
            '<th>On hand</th><th>Max build</th><th>Printed WOs</th><th>Status</th>' +
            '</tr>';

        o.lines.forEach(function (ln) {
            var total = ln.qtyOpen || 1;
            var pStock = Math.round((ln.fromStock / total) * 100);
            var pBuild = Math.round((ln.fromBuild / total) * 100);
            var pShort = Math.max(0, 100 - pStock - pBuild);

            var meter = '<div class="meter" title="' +
                ln.fromStock + ' from stock, ' + ln.fromBuild + ' to build, ' +
                ln.shortfall + ' short">' +
                (pStock ? '<span class="m-stock" style="width:' + pStock + '%"></span>' : '') +
                (pBuild ? '<span class="m-build" style="width:' + pBuild + '%"></span>' : '') +
                (pShort ? '<span class="m-short" style="width:' + pShort + '%"></span>' : '') +
                '</div>';

            // Only name the segments that actually exist -- a key listing zeroes
            // is noise on a board people scan quickly.
            var parts = [];
            if (ln.fromStock) parts.push('<b>' + ln.fromStock + '</b> stock');
            if (ln.fromBuild) parts.push('<b>' + ln.fromBuild + '</b> build');
            if (ln.shortfall) parts.push('<b style="color:#b3241f">' + ln.shortfall + '</b> short');
            var key = '<div class="mkey">' + (parts.join(' &middot; ') || '&mdash;') + '</div>';

            var woBits = [];
            if (ln.wo && ln.wo.woCount > 0) {
                woBits.push('<span class="wocell">' + ln.wo.woCount + ' WO' +
                    (ln.wo.woCount > 1 ? 's' : '') + ' &middot; ' + ln.wo.openQty + ' pcs</span>');
            }
            if (ln.comp && ln.comp.woCount > 0) {
                woBits.push('<span class="wocomp">' + ln.comp.comps +
                    ' component' + (ln.comp.comps > 1 ? 's' : '') + ' on floor</span>');
            }
            var woTxt = woBits.length ? woBits.join('<br>') : '<span class="wonone wocell-wait">none</span>';

            h += '<tr class="c-' + ln.status.key + ' lnrow" data-lst="' + ln.status.key +
                    '" data-litem="' + ln.itemId + '" data-lloc="' + ln.locId +
                    '" data-lshort="' + ln.shortfall + '">' +
                '<td><a class="item" href="' + itemUrl(ln.itemId) + '" target="_blank">' +
                    esc(ln.itemName) + '</a></td>' +
                '<td class="num">' + ln.qtyOpen + '</td>' +
                '<td>' + meter + key + '</td>' +
                '<td class="num">' + ln.qtyAvail + '</td>' +
                '<td class="num">' + ln.maxBuild + '</td>' +
                '<td class="wocol">' + woTxt + '</td>' +
                '<td><span class="pill lpill ' + ln.status.css + '" title="' + esc(ln.status.desc) + '">' +
                    ln.status.label + '</span></td>' +
                '</tr>';

            if (ln.memo) {
                h += '<tr><td colspan="7" class="linememo">' + esc(ln.memo) + '</td></tr>';
            }

            // For a line waiting on the floor, show what is actually running.
            // Collapsed headline only. The work order rows behind it are
            // fetched from &wip=1 the first time someone opens this line.
            if (ln.status.key === 'WIP') {
                var bits = [];
                if (ln.wo && ln.wo.woCount > 0) {
                    bits.push(ln.wo.woCount + ' WO' + (ln.wo.woCount > 1 ? 's' : '') +
                              ' on this item');
                }
                if (ln.comp && ln.comp.woCount > 0) {
                    bits.push(ln.comp.woCount + ' WO' + (ln.comp.woCount > 1 ? 's' : '') +
                              ' on ' + ln.comp.comps + ' component' +
                              (ln.comp.comps > 1 ? 's' : ''));
                }
                h += '<tr><td colspan="7" class="wipcell">' +
                     '<div class="wipbar" data-wip="' + ln.itemId +
                        '" data-loc="' + ln.locId + '" data-short="' + ln.shortfall + '">' +
                     '<span class="wipico">\u25cf</span>' +
                     '<span class="wiphead">On the floor &middot; ' +
                        esc(bits.join(' &middot; ') || 'work in progress') + '</span>' +
                     '<button type="button" class="wipbtn">Detail</button>' +
                     '</div>' +
                     '<div class="wippanel" data-wipfor="' + ln.itemId + '" hidden></div>' +
                     '</td></tr>';
            }
        });

        return h + '</table>';
    }

    /**
     * Returns an HTML FRAGMENT (no <html>/<body>) wrapped in #gyh-bo, suitable
     * for an INLINEHTML field.
     */
    function renderFragment(orders, postUrl) {
        var counts = { SHIP: 0, BUILD: 0, PARTIAL: 0, WIP: 0, BLOCKED: 0 };
        var lateCt = 0;
        orders.forEach(function (o) {
            counts[o.status.key]++;
            if (o.daysLate > 0) lateCt++;
        });

        var h = renderStyles();
        h += '<div id="' + WRAP + '">';

        // Tab bar. Counts are per-tab so each reads as its own report.
        var tabCounts = {};
        orders.forEach(function (o) {
            tabCounts[o.tab] = (tabCounts[o.tab] || 0) + 1;
            if (o.isCustom) tabCounts.CUSTOM = (tabCounts.CUSTOM || 0) + 1;
        });

        // Every tab is rendered; setPlant() recounts them and hides the optional
        // ones that are empty for the selected plant. Server-side filtering would
        // be wrong here, because a tab empty across both plants combined can still
        // have orders in one of them.
        var visibleTabs = TABS;
        var activeTab = null;
        TABS.forEach(function (t) {
            if (!activeTab && !t.overlay && !t.onlyIfPopulated) activeTab = t.key;
        });

        h += '<div class="stickyhead">';

        // Plant switch. Counts are filled in by JS so they stay in step with the
        // rest of the filtering.
        var plantCounts = { '1': 0, '48': 0 };
        orders.forEach(function (o) {
            var k = String(o.locId);
            if (plantCounts.hasOwnProperty(k)) plantCounts[k]++;
        });

        h += '<div class="plants">';
        [
            { id: String(HITCH_LOCATION), label: 'Hitch' },
            { id: String(DOOR_LOCATION),  label: 'Door' }
        ].forEach(function (pl, idx) {
            h += '<button type="button" class="plant' + (idx === 0 ? ' on' : '') +
                 '" data-plant="' + pl.id + '">' + esc(pl.label) +
                 '<span class="pc">' + plantCounts[pl.id] + '</span></button>';
        });
        h += '<span class="asof">as of ' + fmtDate(new Date()) + '</span>';
        h += '</div>';

        h += '<div class="tabs">';
        visibleTabs.forEach(function (t) {
            h += '<div class="tab' + (t.key === activeTab ? ' on' : '') +
                 (t.key === 'UNASSIGNED' ? ' warnTab' : '') +
                 '" data-tab="' + t.key + '" tabindex="0"' +
                 (t.onlyIfPopulated ? ' data-optional="1"' : '') + '>' + esc(t.label) +
                 '<span class="tc">' + (tabCounts[t.key] || 0) + '</span></div>';   // JS recounts per plant
        });
        h += '</div>';

        // Signal chips double as the status filter -- clicking one is the same as
        // choosing it from a dropdown, which is the action people actually want
        // after reading the number.
        var SIGS = [
            { k: 'LATE',    label: 'Past due',  cls: 'c-BLOCKED', filter: '__LATE__' },
            { k: 'SHIP',    label: 'Ship now',  cls: 'c-SHIP',    filter: 'SHIP'    },
            { k: 'BUILD',   label: 'Build now', cls: 'c-BUILD',   filter: 'BUILD'   },
            { k: 'PARTIAL', label: 'Partial',   cls: 'c-PARTIAL', filter: 'PARTIAL' },
            { k: 'WIP',     label: 'WIP',       cls: 'c-WIP',     filter: 'WIP'     },
            { k: 'BLOCKED', label: 'Not started', cls: 'c-BLOCKED', filter: 'BLOCKED' }
        ];

        // One control row: signals on the left, search on the right. Previously
        // these were two stacked bands, which made the header taller than the
        // first few rows of actual data.
        h += '<div class="ctl">';

        // The total is context, not a filter -- giving it a button's active state
        // made it read as a stuck toggle. It is a plain label now; Reset clears.
        // Clicking the total clears the status and past-due filters, showing
        // every order in the current tab. Its "on" state is a quiet underline
        // only -- a filled box made it read as a stuck toggle.
        h += '<button type="button" class="total" title="Show all statuses in this tab">' +
             '<span class="tv num" data-stat="TOTAL">0</span>' +
             '<span class="tk">orders</span></button>' +
             '<span class="totalsep"></span>';

        h += '<div class="signals">';
        SIGS.forEach(function (g) {
            h += '<button type="button" class="sig ' + g.cls + '" data-filter="' + g.filter + '">' +
                 '<span class="v num" data-stat="' + g.k + '">0</span>' +
                 '<span class="k">' + esc(g.label) + '</span>' +
                 '</button>';
        });
        h += '</div>';

        h += '<div class="bar">' +
            '<input id="' + WRAP + '-q" type="text" placeholder="Search order, customer, item or note">' +
            '<label class="chk"><input id="' + WRAP + '-late" type="checkbox"> <span>Past due</span></label>' +
            '<button type="button" class="clear" id="' + WRAP + '-toggleall" ' +
                'data-state="collapsed">Expand all</button>' +
            '<button type="button" class="clear" id="' + WRAP + '-clear" title="Clear all filters">Reset</button>' +
            '<span class="spacer"><b id="' + WRAP + '-cnt" class="num">' + orders.length + '</b> shown</span>' +
            '<select id="' + WRAP + '-st" hidden><option value=""></option>' +
            '<option value="SHIP"></option><option value="BUILD"></option>' +
            '<option value="PARTIAL"></option><option value="WIP"></option>' +
            '<option value="BLOCKED"></option></select>' +
            '</div>';

        h += '</div>';   // close .ctl
        h += '</div>';   // close .stickyhead

        h += '<table class="grid"><tr>' +
            '<th style="width:4px;padding:0"></th>' +
            '<th style="width:16px"></th>' +
            '<th class="sortable" data-sort="num"  data-type="t">Order</th>' +
            '<th class="sortable" data-sort="cust" data-type="t">Customer</th>' +
            '<th class="sortable" data-sort="ord"  data-type="n">Ordered</th>' +
            '<th class="sortable" data-sort="due"  data-type="n">Due</th>' +
            '<th class="sortable" data-sort="late" data-type="n">Late</th>' +
            '<th class="sortable" data-sort="lines" data-type="n">Lines</th>' +
            '<th class="sortable" data-sort="st"   data-type="n">Status</th>' +
            '<th class="sortable" data-sort="notes" data-type="n" ' +
                'title="Orders carrying notes">Notes</th>' +
            '</tr>';

        orders.forEach(function (o) {
            var stickyText = o.stickies.map(function (n) {
                return stickyPlain(n.msg) + ' ' +
                       n.replies.map(function (rp) { return stickyPlain(rp.msg); }).join(' ');
            }).join(' ');

            var search = (String(o.num) + ' ' + o.custName + ' ' + o.parentName + ' ' + o.custNum + ' ' +
                          o.notes + ' ' + stickyText + ' ' +
                          o.lines.map(function (l) { return l.itemName; }).join(' ')).toLowerCase();

            // Severity band for days late: 0 / 1-7 / 8-30 / 30+. Encodes how bad,
            // not just that it is bad.
            var lateCls = o.daysLate <= 0 ? 'l0'
                        : o.daysLate <= 7 ? 'l1'
                        : o.daysLate <= 30 ? 'l2' : 'l3';

            h += '<tr class="ord c-' + o.status.key + '" data-id="' + o.id + '" data-st="' + o.status.key + '" ' +
                 'data-tab="' + o.tab + '" data-custom="' + (o.isCustom ? '1' : '0') + '" ' +
                 'data-loc="' + o.locId + '" ' +
                 'data-late="' + (o.daysLate > 0 ? '1' : '0') + '" ' +
                 'data-search="' + esc(search) + '" ' +
                 'data-s-num="' + esc(o.num) + '" ' +
                 'data-s-cust="' + esc(String(o.custName).toLowerCase()) + '" ' +
                 'data-s-ord="' + (o.tranDate ? o.tranDate.getTime() : 0) + '" ' +
                 'data-s-due="' + (o.dueDate ? o.dueDate.getTime() : 0) + '" ' +
                 'data-s-late="' + o.daysLate + '" ' +
                 'data-s-lines="' + o.lines.length + '" ' +
                 'data-s-st="' + o.status.rank + '" ' +
                 'data-s-amt="' + Math.round(o.total) + '" ' +
                 'data-s-notes="' + ((o.notes ? 1 : 0) + o.stickies.length) + '">' +
                '<td class="edge"><span class="edgebar"></span></td>' +
                '<td><span class="caret" data-for="' + o.id + '">&#9654;</span></td>' +
                '<td><a class="so" href="' + soUrl(o.id) + '" target="_blank">' + esc(o.num) + '</a>' +
                    '<div class="amt num">' + money(o.total) + '</div></td>' +
                '<td><div class="cust">' + esc(o.custName) + '</div>' +
                    '<div class="muted">' +
                    (o.parentName ? esc(o.parentName) + ' &middot; ' : '') +
                    esc(o.custNum) + '</div></td>' +
                '<td class="num">' + fmtDate(o.tranDate) + '</td>' +
                '<td class="num">' + fmtDate(o.dueDate) +
                    (o.dueSource === 'actual'
                        ? '<div class="dueact" title="Scheduled ship date from the order">scheduled</div>'
                        : '<div class="muted">+' + o.leadDays + 'd lead</div>') + '</td>' +
                '<td class="num"><span class="late ' + lateCls + '">' +
                    (o.daysLate > 0 ? o.daysLate : '&mdash;') + '</span></td>' +
                '<td class="num">' + o.lines.length +
                    (o.blockedLines ? ' <span class="muted" style="color:#b3241f">' +
                     o.blockedLines + ' short</span>' : '') + '</td>' +
                '<td><span class="pill opill ' + o.status.css + '" title="' + esc(o.status.desc) + '">' +
                    o.status.label + '</span></td>' +
                '<td class="npip">' + renderNotePips(o) + '</td>' +
                '</tr>';

            h += '<tr class="det" data-for="' + o.id + '"><td colspan="10"><div class="drill">';

            h += '<div class="dmain">' + renderLineTable(o) + '</div>';

            // Notes live on the right, under the notes columns they belong to.
            h += '<div class="dside">';
            if (o.notes) {
                h += '<div class="notes"><b>Sales team notes</b>' + esc(o.notes) + '</div>';
            }
            h += renderStickyThread(o);
            h += renderComposer(o);
            h += '</div>';

            h += '</div></td></tr>';
        });

        h += '</table>';
        h += '<div class="empty" id="' + WRAP + '-empty" style="display:none">' +
             '<div class="big">Nothing matches</div>' +
             'Clear the search or pick a different signal above.</div>';
        h += '</div>';          // close #gyh-bo
        h += renderScript(postUrl);   // runs after the wrapper exists in the DOM

        return h;
    }

    // -------------------------------------------------------------- entry pt

    function onRequest(context) {
        // Writes come in as POST from the composer; the dashboard itself is GET.
        if (context.request.method === 'POST') {
            handlePost(context);
            return;
        }

        // Deferred WIP status for the short lines on the board. Called by the
        // client right after first paint. Returns { <itemId>: {comps, woCount,
        // openQty} } for the items that have components on the floor.
        if (context.request.parameters.wipstatus === '1') {
            context.response.setHeader({ name: 'Content-Type', value: 'application/json' });
            try {
                var raw = String(context.request.parameters.items || '');
                var ids = raw.split(',').map(function (x) { return Number(x); })
                             .filter(function (n) { return n > 0; });
                if (ids.length > 2000) ids = ids.slice(0, 2000);
                var wipMap = fetchComponentFloorCounts(ids);
                log.audit({
                    title: 'wipstatus',
                    details: ids.length + ' short items asked; ' +
                             Object.keys(wipMap).length + ' have components on the floor'
                });
                context.response.write(JSON.stringify({ ok: true, wip: wipMap }));
            } catch (wsErr) {
                log.error({ title: 'wipstatus failed', details: wsErr });
                context.response.write(JSON.stringify({ ok: false, error: wsErr.message || String(wsErr) }));
            }
            return;
        }

        // On-demand WIP detail for ONE item. This is the expensive half, split
        // out so the board's own load never pays for panels nobody opened.
        if (context.request.parameters.wip === '1') {
            context.response.setHeader({ name: 'Content-Type', value: 'application/json' });
            try {
                var wipItem = Number(context.request.parameters.item);
                if (!wipItem) { throw new Error('A valid item id is required.'); }
                context.response.write(JSON.stringify({
                    ok: true,
                    item: wipItem,
                    detail: fetchWipDetail(
                        wipItem,
                        context.request.parameters.loc,
                        context.request.parameters.short
                    )
                }));
            } catch (wipErr) {
                log.error({ title: 'WIP detail failed', details: wipErr });
                context.response.write(JSON.stringify({
                    ok: false,
                    error: wipErr.message || String(wipErr)
                }));
            }
            return;
        }
        if (context.request.method !== 'GET') return;

        var form = serverWidget.createForm({ title: 'Buildable Orders' });

        var fld = form.addField({
            id: 'custpage_gyh_bo_html',
            type: serverWidget.FieldType.INLINEHTML,
            label: ' '
        });

        // Full page width: no column, sits below any field group.
        fld.updateLayoutType({ layoutType: serverWidget.FieldLayoutType.OUTSIDEBELOW });
        fld.updateBreakType({ breakType: serverWidget.FieldBreakType.STARTROW });

        try {
            var user = runtime.getCurrentUser();
            var ctxInfo = 'user ' + user.id + ' / role ' + user.role +
                          ' / subsidiary ' + user.subsidiary +
                          ' / script ' + runtime.getCurrentScript().id;
            log.audit({ title: 'GYH_BuildableOrders_SL start', details: ctxInfo });

            if (context.request.parameters.debug === 'T') {
                fld.defaultValue = renderDebug(runProbes(), ctxInfo);
                context.response.writePage(form);
                return;
            }

            var rows = fetchOpenLines();
            log.audit({ title: 'fetchOpenLines', details: 'rows=' + (rows ? rows.length : 'null') });

            var woMap = fetchDirectWoCounts();
            log.audit({ title: 'fetchDirectWoCounts', details: 'items=' + Object.keys(woMap).length });



            var soIds = [];
            var seenSo = {};
            rows.forEach(function (r) {
                var k = String(r.so_id);
                if (!seenSo[k]) { seenSo[k] = 1; soIds.push(r.so_id); }
            });
            var stickyMap = fetchStickyNotes(soIds);
            log.audit({
                title: 'fetchStickyNotes',
                details: 'orders with stickies=' + Object.keys(stickyMap).length
            });

            var orders = buildModel(rows, woMap, stickyMap);
            log.audit({ title: 'buildModel', details: 'orders=' + orders.length });

            // WIP resolution is NOT done here. The page paints with short lines
            // as "Not started", then the client asks &wipstatus=1 for exactly
            // those items and upgrades them in place. On a cold BOM cache that
            // lookup is the slowest thing this Suitelet does, and it no longer
            // blocks first paint.

            var script = runtime.getCurrentScript();
            var postUrl = url.resolveScript({
                scriptId: script.id,
                deploymentId: script.deploymentId,
                returnExternalUrl: false
            });

            if (!rows || rows.length === 0) {
                log.error({
                    title: 'Query returned zero rows',
                    details: 'Same SQL returns 476 rows via an integration role. ' +
                             'Add &debug=T to the URL to isolate which filter or table is blocked.'
                });
            }

            fld.defaultValue = renderFragment(orders, postUrl);
        } catch (e) {
            log.error({ title: 'GYH_BuildableOrders_SL failed', details: e });
            fld.defaultValue =
                '<div id="' + WRAP + '" style="font-family:Arial;padding:16px">' +
                '<div style="color:#9a1c1c;font-size:15px;font-weight:bold">Report failed to run</div>' +
                '<p>' + esc(e.message || e) + '</p>' +
                '<pre style="background:#f4f4f4;padding:12px;font-size:11px;white-space:pre-wrap">' +
                esc(e.stack || '') + '</pre></div>';
        }

        // writePage keeps the NetSuite header, role switcher and navigation.
        context.response.writePage(form);
    }

    return { onRequest: onRequest };
});
