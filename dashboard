/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @NModuleScope SameAccount
 *
 * GYH_BuildableOrders_SL
 * ----------------------------------------------------------------------------
 * Shows open, unshipped sales orders at the GEN-Y HITCH location and answers:
 *   "Can we build this right now, and if not, why not?"
 *
 * RENDERING CONTRACT (do not change without reading this):
 *   The whole dashboard is delivered as a SINGLE INLINEHTML field on a
 *   serverWidget Form, rendered with response.writePage(). This keeps the
 *   NetSuite header, role switcher and navigation intact. Do NOT switch back to
 *   response.write() with raw HTML -- that produces a bare page with no chrome.
 *
 *   All markup lives inside #gyh-bo. Every CSS rule and every JS symbol is
 *   scoped to that wrapper (JS via the single global GYHBO) so nothing leaks
 *   onto, or collides with, the surrounding NetSuite page. No <html>, <head> or
 *   <body> tags -- NetSuite supplies those.
 *
 * Design decisions (confirmed with Lamar, Aug 2026):
 *   - Location scope ....... location ID 1 (GEN-Y HITCH) ONLY. Child locations
 *                           (Powdercoat, Amazon DC, OFFSITE vendors) excluded.
 *   - Past due ............. trandate + category lead days < today
 *   - Buildability ......... order-level rollup with line-level drill-down
 *   - Competing demand ..... netted. Supply is allocated across orders in due
 *                           date order (earliest first), so the same 42 units
 *                           cannot be promised to three different orders.
 *   - NULL max_buildable ... treated as ZERO / not buildable
 *   - Stock first .......... on-hand available is consumed before build capacity
 *   - WO signal ............ open WOs filtered to custbody_gyh_traveler_printed='T'
 *                           (the job traveler stamp field). Reports presence and
 *                           quantity, NOT a promised date -- see note below.
 *
 * KNOWN DATA CAVEATS (surfaced during build, verified against prod):
 *   1. inventoryitemlocations.quantityavailable is stale account-wide and returns
 *      0 for every item. inventorybalance is the live table. Do not "optimize"
 *      this back to inventoryitemlocations.
 *   2. 7,049 of 12,802 active assemblies have a NULL custitem_gny_max_buildable.
 *      Per decision these count as zero, so the on-hand check carries most of the
 *      weight. If that job ever gets fixed, this report gets much sharper.
 *   3. 92% of open work orders have an enddate in the past (avg 18 days over for
 *      printed WOs). The WO column therefore does NOT promise a completion date.
 *      Showing enddate as an ETA would be actively misleading.
 */

define(['N/query', 'N/ui/serverWidget', 'N/log', 'N/runtime', 'N/record', 'N/url', 'N/cache'],
function (query, serverWidget, log, runtime, record, url, cache) {

    // ---------------------------------------------------------------- config

    var HITCH_LOCATION = 1;    // GEN-Y HITCH
    var DOOR_LOCATION  = 48;   // GEN-Y DOOR

    // Both plants are in scope. No open order currently has lines at both, so an
    // order belongs cleanly to one site; the tab mapping relies on that.
    var SCOPE_LOCATIONS = [HITCH_LOCATION, DOOR_LOCATION];
    var SCOPE_SQL = SCOPE_LOCATIONS.join(',');
    var ACCOUNT_ID     = '5262266';
    var WRAP           = 'gyh-bo';   // single wrapper id -- everything scopes to this

    // Lead time in days by customer category ID. Source: Lamar, Aug 2026.
    // Key 0 = customer record has no category set.
    var LEAD_DAYS = {
        0: 10,   // (no category set)
        1: 10,   // National Distribution
        2: 10,   // E-Commerce Wholesale
        4: 10,   // Master Dealer
        5: 5,    // Inside Sales
        6: 5,    // GEN-Y US Web Orders
        7: 5,    // GEN-Y CDN Web Orders
        8: 5,    // Amazon US
        9: 5,    // AMAZON-CAN
        10: 5,   // Ebay-US
        11: 10,  // Standard Dealer
        13: 10,  // Regional Distribution
        14: 5,   // Jobber/Fleet
        15: 15,  // Manufacturer/OEM
        16: 15,  // Sponsor Account
        17: 10,  // Canada
        18: 5,   // Not Specified
        21: 0,   // GEN-Y WEB-US -IA
        22: 10,  // Inter Company
        23: 10,  // Chile
        24: 10,  // United Kingdom
        25: 10,  // Box Store
        26: 5,   // Walmart
        29: 30,  // International Distributor
        30: 5,   // TikTok
        31: 10   // Canada Distributor
    };
    var DEFAULT_LEAD_DAYS = 10;

    /**
     * Builds a status predicate that matches BOTH status formats.
     *
     * This is the single nastiest portability trap in this script. SuiteQL run
     * through the REST/SuiteTalk endpoint returns transaction status as the bare
     * code ('B'). SuiteQL run through N/query inside a Suitelet returns it
     * PREFIXED with the transaction type ('SalesOrd:B', 'WorkOrd:B').
     *
     * A filter written for one form silently matches NOTHING in the other -- no
     * error, no warning, just an empty report. Always filter through this helper.
     */
    function statusIn(col, type, codes) {
        var vals = [];
        codes.forEach(function (c) {
            vals.push("'" + c + "'");                 // bare form:    B
            vals.push("'" + type + ":" + c + "'");    // prefixed form: SalesOrd:B
        });
        return '(' + col + ' IN (' + vals.join(',') + '))';
    }

    /**
     * StickyNotes (the bundle, not NetSuite's built-in User Notes) stores notes in
     * CUSTOMRECORD_STICK_NOTE, linked by record-type string + record id rather
     * than a real foreign key. The built-in `note` record is NOT used for these:
     * it holds 28 sales-order rows account-wide, newest from 2023, and its text
     * fields are not exposed to SuiteQL at all.
     *
     * A note with is_public='F' is restricted to custrecord_sn_allowed_entities.
     * This Suitelet runs as Administrator so it CAN read them; set this to false
     * to show only public notes.
     */
    var SHOW_PRIVATE_STICKIES = true;

    var STICKY_PRIORITY = { 1: 'High', 2: 'Normal', 3: 'Low' };

    /**
     * Values the StickyNotes bundle expects on a note it will render. Taken from
     * the 418 existing sales-order notes, which are uniform on all of these.
     *
     * -102 is the bundle's internal code for the sales order record type.
     * percent_top / percent_left place the note on the record page; existing
     * notes cluster in the top-right, so a new one lands there too and the user
     * can drag it afterwards.
     */
    var STICKY_NEW = {
        scriptedRecordType: -102,
        recordTypeScriptId: 'salesorder',
        zIndex: 101,
        status: 'new',
        percentTop: 20,
        percentLeft: 84
    };

    var SO_OPEN = ['A', 'B', 'D', 'E'];   // Pending Approval, Pending Fulfillment,
                                          // Partially Fulfilled, Pending Billing/Part Fulfilled
    var WO_OPEN = ['A', 'B', 'D'];        // Planned, Released, In Process
    var WO_STATUS = { A: 'Planned', B: 'Released', D: 'In process' };

    /**
     * "On the floor" = traveler printed AND released to production.
     * Planned (A) is excluded: it is scheduled, not running.
     *
     * Measured in this account: 838 open WOs meet this bar and every one of
     * them is a COMPONENT work order. No GH- finished-goods WO is ever
     * traveler-printed, so the floor signal for a sellable item comes from its
     * components, not from its own work order.
     */
    var WO_FLOOR = ['B', 'D'];

    /**
     * How far back to look for an item's most recent work order when deriving
     * its component list.
     *
     * Without this bound the MAX(w2.id) GROUP BY scans every work order line in
     * the account and the query does not return at all. A part built in the
     * last year has a current BOM; one that has not been built in a year is not
     * going to be on the floor today either.
     */
    var WO_LOOKBACK_MONTHS = 12;

    /**
     * BOM component lists are CACHED across page loads.
     *
     * Deriving an item's components (via its latest work order) is the single
     * most expensive query this Suitelet runs, and the answer barely changes:
     * components are built to stock, and a GH- part's BOM is the same today as
     * it was this morning. Caching it means only the first load after the cache
     * expires pays for it; every later load reads the list back in one call.
     *
     * The floor-WO counts are NOT cached -- those change as Maynard prints
     * travelers and jobs complete, and the aggregate is cheap anyway.
     */
    var BOM_CACHE_NAME = 'gyh_bo_bom';
    var BOM_CACHE_TTL  = 6 * 60 * 60;   // seconds; 6 hours
    function floorWoPredicate(alias) {
        return statusIn(alias + '.status', 'WorkOrd', WO_FLOOR) +
               " AND " + alias + ".custbody_gyh_traveler_printed = 'T'";
    }

    /**
     * Customer type tabs. Maps customer category ID -> tab key.
     * Any category not listed falls to UNASSIGNED, as does a customer record with
     * no category set at all (cat_id 0).
     */
    var TAB_OF_CATEGORY = {
        // Retail / direct-to-consumer / marketplace
        5:  'RETAIL',   // Inside Sales
        6:  'RETAIL',   // GEN-Y US Web Orders
        7:  'RETAIL',   // GEN-Y CDN Web Orders
        8:  'RETAIL',   // Amazon US
        9:  'RETAIL',   // AMAZON-CAN
        10: 'RETAIL',   // Ebay-US
        21: 'RETAIL',   // GEN-Y WEB-US -IA
        25: 'RETAIL',   // Box Store
        26: 'RETAIL',   // Walmart
        30: 'RETAIL',   // TikTok

        // OEM / manufacturers building us into their product
        15: 'OEM',      // Manufacturer/OEM
        16: 'OEM',      // Sponsor Account
        22: 'OEM',      // Inter Company

        // Wholesale / distribution / dealer network
        1:  'WHOLESALE',  // National Distribution
        2:  'WHOLESALE',  // E-Commerce Wholesale
        4:  'WHOLESALE',  // Master Dealer
        11: 'WHOLESALE',  // Standard Dealer
        13: 'WHOLESALE',  // Regional Distribution
        14: 'WHOLESALE',  // Jobber/Fleet
        17: 'WHOLESALE',  // Canada
        18: 'WHOLESALE',  // Not Specified
        23: 'WHOLESALE',  // Chile
        24: 'WHOLESALE',  // United Kingdom
        28: 'WHOLESALE',  // House Account
        29: 'WHOLESALE',  // International Distributor
        31: 'WHOLESALE'   // Canada Distributor
    };

    // Order matters -- this is left-to-right tab order.
    // UNASSIGNED renders only when it actually has orders, so in normal operation
    // this is a three-tab report as specified.
    /**
     * Tabs. RETAIL / OEM / WHOLESALE / UNASSIGNED are exclusive -- an order sits
     * in exactly one. CUSTOM is an OVERLAY: it pulls any order with "custom" in a
     * line description regardless of which exclusive tab it belongs to, so its
     * count deliberately overlaps the others.
     */
    var TABS = [
        { key: 'RETAIL',     label: 'Retail' },
        { key: 'OEM',        label: 'OEM' },
        { key: 'WHOLESALE',  label: 'Wholesale' },
        { key: 'CUSTOM',     label: 'Custom', overlay: true, onlyIfPopulated: true },
        { key: 'UNASSIGNED', label: 'Unassigned', onlyIfPopulated: true }
    ];

    function tabForCategory(catId) {
        return TAB_OF_CATEGORY[catId] || 'UNASSIGNED';
    }

    /**
     * Status vocabulary. `desc` is the hover tooltip on the pill -- kept to one
     * sentence each, because a tooltip people actually read is a short one.
     */
    var STATUS = {
        SHIP: {
            key: 'SHIP', label: 'Ship now', rank: 0, css: 'st-ship',
            desc: 'Finished stock is on the shelf at GEN-Y HITCH. Pick and ship today, no manufacturing needed.'
        },
        BUILD: {
            key: 'BUILD', label: 'Build now', rank: 1, css: 'st-build',
            desc: 'Not enough finished stock, but components are on hand and unclaimed. Release a work order and it can go.'
        },
        PARTIAL: {
            key: 'PARTIAL', label: 'Partial', rank: 2, css: 'st-part',
            desc: 'Part of the quantity is covered, part is not. Expand to see how much can ship and how many units are short.'
        },
        WIP: {
            key: 'WIP', label: 'WIP', rank: 3, css: 'st-wip',
            desc: 'On the floor now: an open work order with a printed traveler. In progress, not a promised date.'
        },
        BLOCKED: {
            key: 'BLOCKED', label: 'Not started', rank: 4, css: 'st-block',
            desc: 'No stock, no build capacity, no work order. Nothing is moving on this one yet.'
        }
    };

    // ----------------------------------------------------------------- utils

    function esc(v) {
        if (v === null || v === undefined) return '';
        return String(v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function num(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }

    function parseNsDate(s) {
        // NetSuite SuiteQL returns MM/DD/YYYY
        if (!s) return null;
        var p = String(s).split('/');
        if (p.length !== 3) return null;
        return new Date(parseInt(p[2], 10), parseInt(p[0], 10) - 1, parseInt(p[1], 10));
    }

    function addDays(d, n) {
        var r = new Date(d.getTime());
        r.setDate(r.getDate() + n);
        return r;
    }

    function fmtDate(d) {
        if (!d) return '';
        return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();
    }

    function daysBetween(a, b) {
        return Math.round((b.getTime() - a.getTime()) / 86400000);
    }

    /**
     * Order notes are free text and run long (some are multi-sentence updates
     * from the sales team). The row shows a clipped preview with the full text on
     * hover; the drill-down still shows it in full.
     */
    function clip(txt, max) {
        var t = String(txt || '').replace(/\s+/g, ' ').trim();
        if (!t) return '';
        return (t.length <= max) ? t : t.substring(0, max - 1) + '\u2026';
    }

    /**
     * StickyNotes stores line breaks as the literal token [br]. Escape FIRST,
     * then convert -- doing it the other way round would let a note body inject
     * markup into the page.
     */
    function stickyHtml(msg) {
        return esc(msg).replace(/\[br\]/gi, '<br>');
    }

    function stickyPlain(msg) {
        return String(msg || '').replace(/\[br\]/gi, ' ').replace(/\s+/g, ' ').trim();
    }

    function money(v) {
        var n = Math.round(num(v));
        return '$' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    }

    function soUrl(id) {
        return '/app/accounting/transactions/salesord.nl?id=' + id;
    }

    function woUrl(id) {
        return '/app/accounting/transactions/workord.nl?id=' + id;
    }

    function itemUrl(id) {
        return '/app/common/item/item.nl?id=' + id;
    }

    // ------------------------------------------------------------- data pull

    /**
     * Open, unshipped SO lines at the hitch location.
     * One row per SO line. Header data repeats -- grouped in JS.
     */
    function fetchOpenLines() {
        var sql =
            "SELECT " +
            "  t.id                AS so_id, " +
            "  t.tranid            AS so_num, " +
            "  t.trandate          AS tran_date, " +
            "  t.status            AS so_status, " +
            "  t.custbody_ordernotes AS order_notes, " +
            "  c.id                AS cust_id, " +
            "  c.entityid          AS cust_num, " +
            // companyname is NULL on person-type customers (their name lives in
            // altname), so fall through to it. Parent is pulled separately so a
            // subcustomer shows which account it belongs to.
            "  NVL(c.companyname, c.altname) AS cust_name, " +
            "  NVL(p.companyname, p.altname) AS parent_name, " +
            "  NVL(c.category, 0)  AS cat_id, " +
            "  tl.uniquekey        AS line_id, " +   // tl.id is the per-order line index, NOT unique
            "  tl.linesequencenumber AS line_seq, " +
            "  tl.memo             AS line_memo, " +
            "  i.id                AS item_id, " +
            "  i.itemid            AS item_name, " +
            "  i.itemtype          AS item_type, " +
            "  ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) AS qty_open, " +
            "  NVL(i.custitem_gny_max_buildable, 0) AS max_build, " +
            "  NVL(ib.avail, 0)    AS qty_avail, " +
            "  NVL(ib.onhand, 0)   AS qty_onhand, " +
            "  tlm.expectedshipdate AS exp_ship, " +
            "  tl.location         AS loc_id, " +
            "  t.total             AS order_total, " +
            // Channel flag, not a category: Shopify orders sit under many
            // customer categories, so this overrides the tab mapping.
            "  CASE WHEN t.custbody_shopify_order_id IS NOT NULL THEN 1 ELSE 0 END AS is_shopify, " +
            // "Custom" lives in the line description as typed onto the order.
            "  CASE WHEN UPPER(tl.memo) LIKE '%CUSTOM%' " +
            "         OR UPPER(i.displayname) LIKE '%CUSTOM%' THEN 1 ELSE 0 END AS is_custom " +
            "FROM transaction t " +
            "JOIN customer c ON c.id = t.entity " +
            "LEFT JOIN customer p ON p.id = c.parent " +
            "JOIN transactionline tl ON tl.transaction = t.id " +
            "JOIN item i ON i.id = tl.item " +
            // On-hand must come from the line's OWN plant. Joining on item alone
            // would let door stock satisfy a hitch line and vice versa.
            "LEFT JOIN ( " +
            "   SELECT item, location, SUM(quantityonhand) AS onhand, " +
            "          SUM(quantityavailable) AS avail " +
            "   FROM inventorybalance WHERE location IN (" + SCOPE_SQL + ") " +
            "   GROUP BY item, location " +
            ") ib ON ib.item = tl.item AND ib.location = tl.location " +
            // Real ship date lives on the MAINLINE row. transaction.enddate is
            // null account-wide, so do not reach for it.
            "LEFT JOIN transactionline tlm ON tlm.transaction = t.id AND tlm.mainline = 'T' " +
            "WHERE t.type = 'SalesOrd' " +
            "  AND " + statusIn('t.status', 'SalesOrd', SO_OPEN) + " " +
            "  AND tl.mainline = 'F' " +
            "  AND tl.location IN (" + SCOPE_SQL + ") " +
            "  AND tl.isclosed = 'F' " +
            "  AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
            "  AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0 " +
            "ORDER BY t.trandate, t.tranid, tl.linesequencenumber";

        return query.runSuiteQL({ query: sql }).asMappedResults();
    }

    // ---------------------------------------------------------- WIP lookups
    //
    // SPLIT BY COST, mirroring the shop-floor tablet's blocker panel:
    //
    //   CHEAP  (every page load)  -- two aggregate queries returning ONE ROW
    //          PER ITEM: how many work orders are on the floor for the item
    //          itself, and how many of its components are. That is everything
    //          the status pill and the collapsed headline need.
    //   COSTLY (on demand, one item) -- the actual work order rows, their
    //          progress, and which component each belongs to. Fetched only when
    //          someone opens a line.
    //
    // The previous version pulled every open work order in the account with up
    // to 8 full rows each, plus 1,613 BOM component links, on every single load
    // -- to render panels that were collapsed and that nobody had asked for.

    /**
     * Per-item count of work orders ON THE FLOOR for that exact item.
     * Counts only; no rows.
     */
    function fetchDirectWoCounts() {
        var sql =
            "SELECT wl.item AS item_id, " +
            "  COUNT(*) AS wo_ct, " +
            "  SUM(ABS(NVL(wl.quantity,0)) - ABS(NVL(wl.quantityshiprecv,0))) AS open_qty " +
            "FROM transaction w " +
            "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
            "WHERE w.type = 'WorkOrd' AND " + floorWoPredicate('w') + " " +
            "GROUP BY wl.item";

        var map = {};
        query.runSuiteQL({ query: sql }).asMappedResults().forEach(function (r) {
            map[String(r.item_id)] = { woCount: num(r.wo_ct), openQty: num(r.open_qty) };
        });
        return map;
    }

    /**
     * Level-1 components for the given items, from a per-item cache. Only
     * items missing from the cache hit the database, and those are queried in
     * small date-bounded chunks and written back for next time.
     *
     * Returns { <itemId>: [componentItemId, ...] }.
     */
    function fetchBomLinksCached(itemIds) {
        var links = {};
        if (!itemIds || !itemIds.length) return links;

        var store = null;
        try {
            store = cache.getCache({ name: BOM_CACHE_NAME, scope: cache.Scope.PROTECTED });
        } catch (e) {
            log.audit({ title: 'BOM cache unavailable, querying live', details: e.message || e });
        }

        var missing = [];
        itemIds.forEach(function (id) {
            var k = String(id);
            var hit = null;
            if (store) {
                try { hit = store.get({ key: 'bom2:' + k }); } catch (e2) { hit = null; }
            }
            if (hit !== null && hit !== undefined) {
                try { links[k] = JSON.parse(hit); } catch (e3) { missing.push(id); }
            } else {
                missing.push(id);
            }
        });

        if (missing.length) {
            var CHUNK = 60;
            for (var i = 0; i < missing.length; i += CHUNK) {
                var ids = missing.slice(i, i + CHUNK).join(',');
                // per_unit = component qty on the WO / WO build qty. That is the
                // BOM quantity per finished unit, which the short-component
                // detail multiplies by the line's shortfall.
                var sql =
                    "SELECT wl.item AS parent_item, cl.item AS comp_item, " +
                    "  CASE WHEN ABS(NVL(wl.quantity,0)) > 0 " +
                    "       THEN ABS(NVL(cl.quantity,0)) / ABS(NVL(wl.quantity,0)) ELSE 0 END AS per_unit " +
                    "FROM ( " +
                    "   SELECT wl2.item AS built_item, MAX(w2.id) AS latest_wo " +
                    "   FROM transaction w2 " +
                    "   JOIN transactionline wl2 ON wl2.transaction = w2.id AND wl2.mainline = 'T' " +
                    "   WHERE w2.type = 'WorkOrd' " +
                    "     AND w2.trandate >= ADD_MONTHS(TRUNC(SYSDATE),-" + WO_LOOKBACK_MONTHS + ") " +
                    "     AND wl2.item IN (" + ids + ") " +
                    "   GROUP BY wl2.item " +
                    ") latest " +
                    "JOIN transactionline wl ON wl.transaction = latest.latest_wo AND wl.mainline = 'T' " +
                    "JOIN transactionline cl ON cl.transaction = latest.latest_wo " +
                    "     AND cl.mainline = 'F' AND cl.item IS NOT NULL AND cl.item <> wl.item";

                var fresh = {};
                query.runSuiteQL({ query: sql }).asMappedResults().forEach(function (r) {
                    var k = String(r.parent_item);
                    if (!fresh[k]) fresh[k] = [];
                    var dup = false;
                    for (var d = 0; d < fresh[k].length; d++) {
                        if (fresh[k][d].id === r.comp_item) { fresh[k][d].perUnit += num(r.per_unit); dup = true; break; }
                    }
                    if (!dup) fresh[k].push({ id: r.comp_item, perUnit: num(r.per_unit) });
                });

                // Cache every item we asked about, including the ones with no
                // BOM, so an item without one is not re-queried on every load.
                missing.slice(i, i + CHUNK).forEach(function (id) {
                    var k = String(id);
                    var list = fresh[k] || [];
                    links[k] = list;
                    if (store) {
                        try {
                            store.put({ key: 'bom2:' + k, value: JSON.stringify(list), ttl: BOM_CACHE_TTL });
                        } catch (e4) { /* cache write is best-effort */ }
                    }
                });
            }
        }

        log.audit({
            title: 'fetchBomLinksCached',
            details: (itemIds.length - missing.length) + ' from cache, ' + missing.length + ' queried'
        });
        return links;
    }

    /**
     * Floor work orders aggregated per COMPONENT item. One cheap query over
     * the ~840 printed+released WOs; not cached, because this is the part that
     * moves during the day.
     */
    function fetchFloorWoByItem() {
        var sql =
            "SELECT wl.item AS item_id, COUNT(*) AS wo_ct, " +
            "  SUM(ABS(NVL(wl.quantity,0)) - ABS(NVL(wl.quantityshiprecv,0))) AS open_qty " +
            "FROM transaction w " +
            "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
            "WHERE w.type = 'WorkOrd' AND " + floorWoPredicate('w') + " " +
            "GROUP BY wl.item";
        var map = {};
        query.runSuiteQL({ query: sql }).asMappedResults().forEach(function (r) {
            map[String(r.item_id)] = { woCount: num(r.wo_ct), openQty: num(r.open_qty) };
        });
        return map;
    }

    /**
     * Per-item component-on-floor counts, assembled in JS from the cached BOM
     * links and the live floor aggregate. No per-item database work at all
     * once the cache is warm.
     */
    function fetchComponentFloorCounts(itemIds) {
        var out = {};
        if (!itemIds || !itemIds.length) return out;

        var links = fetchBomLinksCached(itemIds);
        var floor = fetchFloorWoByItem();

        itemIds.forEach(function (id) {
            var k = String(id);
            var comps = 0, woCount = 0, openQty = 0;
            (links[k] || []).forEach(function (c) {
                var f = floor[String(c.id)];
                if (f && f.woCount > 0) {
                    comps++;
                    woCount += f.woCount;
                    openQty += f.openQty;
                }
            });
            if (woCount > 0) out[k] = { comps: comps, woCount: woCount, openQty: openQty };
        });
        return out;
    }

    /**
     * ON-DEMAND detail for ONE item: the work order rows behind the counts.
     * Returns { direct: [...], components: [...], unprintedDirect: n }.
     *
     * unprintedDirect exists so nothing disappears silently: an item can have
     * open work orders that simply have no traveler printed, and the panel says
     * so rather than showing an empty section.
     */
    /**
     * Where a work order physically is: its lowest still-open operation and
     * that operation's work center. Pre-aggregated MIN() inline view JOINed in,
     * never a correlated subquery. Returned as a SQL fragment to JOIN against
     * an alias holding the WO id.
     */
    function currentOpJoin(woAlias) {
        return "LEFT JOIN ( " +
            "   SELECT m.workorder AS w, m.title AS opname, eg.groupname AS wcname, " +
            "          NVL(m.completedquantity,0) AS opcomq, NVL(m.inputquantity,0) AS opinq " +
            "   FROM manufacturingoperationtask m " +
            "   LEFT JOIN entitygroup eg ON eg.id = m.manufacturingworkcenter " +
            "   JOIN ( SELECT m2.workorder AS w2, MIN(m2.operationsequence) AS minseq " +
            "          FROM manufacturingoperationtask m2 " +
            "          WHERE NVL(m2.completedquantity,0) < NVL(m2.inputquantity,0) " +
            "          GROUP BY m2.workorder ) mo " +
            "     ON mo.w2 = m.workorder AND mo.minseq = m.operationsequence " +
            ") op ON op.w = " + woAlias + ".id ";
    }

    // Work-center names are line-prefixed ("Hitch - Lathe"); the prefix is
    // noise on a card that already says which plant you are looking at.
    function shortWc(n) {
        return String(n || '').replace(/^\s*(hitch|door)\s*[-\u2013]\s*/i, '').trim();
    }

    function fetchWipDetail(itemId, locId, shortQty) {
        var id = Number(itemId);
        var loc = Number(locId) || HITCH_LOCATION;
        var shortUnits = Math.max(0, num(shortQty));
        if (!id) return { direct: [], components: [], shorts: [], unprintedDirect: 0 };

        var woCols =
            "SELECT w.id, w.tranid, w.status, w.enddate, " +
            "  ABS(NVL(wl.quantity,0))         AS qty, " +
            "  ABS(NVL(wl.quantityshiprecv,0)) AS built, " +
            "  NVL(w.custbody_gyh_traveler_printed,'F') AS printed, " +
            "  op.opname, op.wcname, op.opcomq, op.opinq ";

        function mapWo(r, compId, compName) {
            return {
                id: r.id,
                tranid: r.tranid,
                status: WO_STATUS[String(r.status).replace('WorkOrd:', '')] || r.status,
                endDate: r.enddate,
                qty: num(r.qty),
                built: num(r.built),
                printed: String(r.printed) === 'T',
                comp: compId || null,
                compName: compName || '',
                // where it is on the floor
                opName: r.opname || '',
                wc: shortWc(r.wcname),
                opDone: num(r.opcomq),
                opQty: num(r.opinq)
            };
        }

        // Work orders building this exact item, on the floor.
        var direct = query.runSuiteQL({
            query: woCols +
                "FROM transaction w " +
                "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
                currentOpJoin('w') +
                "WHERE w.type = 'WorkOrd' AND wl.item = " + id + " " +
                "  AND " + floorWoPredicate('w') + " " +
                "ORDER BY w.enddate"
        }).asMappedResults().map(function (r) { return mapWo(r); });

        // Open-but-not-printed work orders on this item, counted only.
        var unprinted = 0;
        try {
            var u = query.runSuiteQL({
                query: "SELECT COUNT(*) AS n FROM transaction w " +
                       "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
                       "WHERE w.type = 'WorkOrd' AND wl.item = " + id + " " +
                       "  AND " + statusIn('w.status', 'WorkOrd', WO_OPEN) + " " +
                       "  AND NVL(w.custbody_gyh_traveler_printed,'F') <> 'T'"
            }).asMappedResults();
            unprinted = u.length ? num(u[0].n) : 0;
        } catch (e) { unprinted = 0; }

        // Components of this item that are on the floor. The component list
        // comes from the cache, so this is one indexed lookup over a short
        // IN list rather than a re-derivation of the BOM.
        var comps = [];
        var compLinks = (fetchBomLinksCached([id])[String(id)] || []);
        var compIds = compLinks.map(function (c) { return c.id; });
        if (compIds.length) {
            comps = query.runSuiteQL({
                query:
                    "SELECT wl.item AS comp_id, ci.itemid AS comp_name, " +
                    "  w.id, w.tranid, w.status, w.enddate, " +
                    "  ABS(NVL(wl.quantity,0))         AS qty, " +
                    "  ABS(NVL(wl.quantityshiprecv,0)) AS built, " +
                    "  NVL(w.custbody_gyh_traveler_printed,'F') AS printed, " +
                    "  op.opname, op.wcname, op.opcomq, op.opinq " +
                    "FROM transaction w " +
                    "JOIN transactionline wl ON wl.transaction = w.id AND wl.mainline = 'T' " +
                    "JOIN item ci ON ci.id = wl.item " +
                    currentOpJoin('w') +
                    "WHERE w.type = 'WorkOrd' AND " + floorWoPredicate('w') + " " +
                    "  AND wl.item IN (" + compIds.map(Number).join(',') + ") " +
                    "ORDER BY ci.itemid, w.enddate"
            }).asMappedResults().map(function (r) { return mapWo(r, r.comp_id, r.comp_name); });
        }

        // ---- Which component is this line actually waiting on? ----------------
        // need  = BOM per-unit qty x units short on this line
        // have  = available at the line's plant
        // Only components with need > have are the reason the line is short.
        // Everything else has stock and is not the bottleneck, however many
        // work orders happen to be running on it.
        var shorts = [];
        if (compLinks.length && shortUnits > 0) {
            var onHand = {};
            try {
                query.runSuiteQL({
                    query:
                        "SELECT item, SUM(NVL(quantityavailable,0)) AS avail " +
                        "FROM inventorybalance " +
                        "WHERE location = " + loc + " AND item IN (" + compIds.map(Number).join(',') + ") " +
                        "GROUP BY item"
                }).asMappedResults().forEach(function (r) { onHand[String(r.item)] = num(r.avail); });
            } catch (e) { /* treat as zero on hand */ }

            var names = {};
            comps.forEach(function (w) { if (w.comp) names[String(w.comp)] = w.compName; });
            var missingNames = compIds.filter(function (c) { return !names[String(c)]; });
            if (missingNames.length) {
                try {
                    query.runSuiteQL({
                        query: "SELECT id, itemid FROM item WHERE id IN (" + missingNames.map(Number).join(',') + ")"
                    }).asMappedResults().forEach(function (r) { names[String(r.id)] = r.itemid; });
                } catch (e2) { /* fall back to ids */ }
            }

            compLinks.forEach(function (c) {
                var need = c.perUnit * shortUnits;
                var have = onHand[String(c.id)] || 0;
                if (need > have + 0.0001) {
                    shorts.push({
                        id: c.id,
                        name: names[String(c.id)] || ('item ' + c.id),
                        perUnit: c.perUnit,
                        need: Math.round(need * 1000) / 1000,
                        have: Math.round(have * 1000) / 1000,
                        short: Math.round((need - have) * 1000) / 1000,
                        wos: comps.filter(function (w) { return String(w.comp) === String(c.id); })
                    });
                }
            });
            shorts.sort(function (a, b) { return b.short - a.short; });
        }

        return { direct: direct, components: comps, shorts: shorts, unprintedDirect: unprinted };
    }

    // ----------------------------------------------------------- diagnostics

    /**
     * Runs a ladder of progressively narrower queries. The first row that drops
     * to zero names the predicate that is killing the report. Run this by adding
     * &debug=T to the Suitelet URL.
     *
     * This exists because SuiteQL run through an integration role and SuiteQL run
     * inside a Suitelet do NOT always see the same rows -- role permissions,
     * subsidiary restrictions and feature access all apply at query time.
     */
    function runProbes() {
        var probes = [
            ['1. any transaction row',
             "SELECT COUNT(*) AS n FROM transaction"],

            ['2. sales orders',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd'"],

            ['3. + open status A/B/D/E',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND " + statusIn('status', 'SalesOrd', SO_OPEN)],

            ['3b. status format check (bare codes)',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND status IN ('A','B','D','E')"],

            ['3c. status format check (prefixed codes)',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'SalesOrd' " +
             "AND status IN ('SalesOrd:A','SalesOrd:B','SalesOrd:D','SalesOrd:E')"],

            ['4. + joined to lines',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " AND tl.mainline = 'F'"],

            ['5. + location in (' + SCOPE_SQL + ')',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ")"],

            ['6. + line open and item type',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ")" + " " +
             "AND tl.isclosed = 'F' AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
             "AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0"],

            ['7. + join customer',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN customer c ON c.id = t.entity " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ")"],

            ['8. + join item',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "JOIN item i ON i.id = tl.item " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ")"],

            ['9. inventorybalance readable',
             "SELECT COUNT(*) AS n FROM inventorybalance WHERE location IN (" + SCOPE_SQL + ")"],

            ['10. item.custitem_gny_max_buildable readable',
             "SELECT COUNT(*) AS n FROM item WHERE custitem_gny_max_buildable IS NOT NULL"],

            ['11. transaction.custbody_ordernotes readable',
             "SELECT COUNT(*) AS n FROM transaction WHERE custbody_ordernotes IS NOT NULL"],

            ['12. WO printed flag readable',
             "SELECT COUNT(*) AS n FROM transaction WHERE type = 'WorkOrd' " +
             "AND custbody_gyh_traveler_printed = 'T'"],

            ['13. FULL production query',
             "SELECT COUNT(*) AS n FROM transaction t " +
             "JOIN customer c ON c.id = t.entity " +
             "JOIN transactionline tl ON tl.transaction = t.id " +
             "JOIN item i ON i.id = tl.item " +
             "WHERE t.type = 'SalesOrd' AND " + statusIn('t.status','SalesOrd',SO_OPEN) + " " +
             "AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ")" + " " +
             "AND tl.isclosed = 'F' AND tl.itemtype IN ('Assembly','InvtPart','Kit') " +
             "AND ABS(NVL(tl.quantity,0)) - ABS(NVL(tl.quantityshiprecv,0)) > 0"]
        ];

        return probes.map(function (p) {
            var out = { label: p[0], count: null, error: null };
            try {
                var res = query.runSuiteQL({ query: p[1] }).asMappedResults();
                out.count = (res && res.length) ? num(res[0].n) : 0;
            } catch (e) {
                out.error = e.message || String(e);
            }
            log.audit({ title: 'PROBE ' + p[0], details: out.error ? ('ERROR: ' + out.error) : out.count });
            return out;
        });
    }

    function renderDebug(probes, ctxInfo) {
        var h = renderStyles();
        h += '<div id="' + WRAP + '">';
        h += '<div class="hd">Buildable Orders &mdash; Diagnostics</div>';
        h += '<div class="sub">The first step that returns 0 is the one breaking the report. ' +
             'Remove &amp;debug=T from the URL to return to the dashboard.</div>';

        h += '<div class="warn"><b>Execution context:</b> ' + esc(ctxInfo) + '</div>';

        h += '<table class="grid"><tr><th>Step</th><th>Rows</th><th>Result</th></tr>';
        probes.forEach(function (p) {
            var cell, pill;
            if (p.error) {
                cell = '<span class="late">error</span>';
                pill = '<span class="pill st-block">' + esc(p.error) + '</span>';
            } else if (p.count === 0) {
                cell = '<span class="late">0</span>';
                pill = '<span class="pill st-block">returns nothing</span>';
            } else {
                cell = p.count;
                pill = '<span class="pill st-ship">ok</span>';
            }
            h += '<tr><td>' + esc(p.label) + '</td><td>' + cell + '</td><td>' + pill + '</td></tr>';
        });
        h += '</table></div>';
        return h;
    }

    /**
     * Sticky notes plus their replies for the given sales order ids, newest first.
     * Returns { <soId>: [ { date, msg, priority, isPublic, replies:[] } ] }.
     */
    function fetchStickyNotes(soIds) {
        var byOrder = {};
        if (!soIds || !soIds.length) return byOrder;

        var CHUNK = 300;
        var noteIndex = {};

        for (var i = 0; i < soIds.length; i += CHUNK) {
            var ids = soIds.slice(i, i + CHUNK).join(',');
            var sql =
                "SELECT sn.id, sn.custrecord_sn_record_id AS so_id, sn.created, " +
                "  sn.custrecord_sn_message AS msg, " +
                "  sn.custrecord_sn_note_category AS priority, " +
                "  sn.custrecord_sn_is_public AS is_public " +
                "FROM CUSTOMRECORD_STICK_NOTE sn " +
                "WHERE sn.custrecord_sn_record_type_script_id = 'salesorder' " +
                "  AND sn.isinactive = 'F' " +
                (SHOW_PRIVATE_STICKIES ? "" : "  AND sn.custrecord_sn_is_public = 'T' ") +
                "  AND sn.custrecord_sn_record_id IN (" + ids + ") " +
                "ORDER BY sn.created DESC, sn.id DESC";

            query.runSuiteQL({ query: sql }).asMappedResults().forEach(function (r) {
                var note = {
                    id: r.id,
                    date: r.created,
                    msg: r.msg || '',
                    priority: STICKY_PRIORITY[r.priority] || '',
                    isPublic: r.is_public !== 'F',
                    replies: []
                };
                var k = String(r.so_id);
                if (!byOrder[k]) byOrder[k] = [];
                byOrder[k].push(note);
                noteIndex[String(r.id)] = note;
            });
        }

        // Replies carry the answers ("shipping 8-18-26", "Brock advised Tue 7/14"),
        // so they matter more than the question they hang off.
        var noteIds = Object.keys(noteIndex);
        for (var j = 0; j < noteIds.length; j += CHUNK) {
            var nids = noteIds.slice(j, j + CHUNK).join(',');
            var rsql =
                "SELECT r.custrecord_snr_note AS note_id, r.created, " +
                "  r.custrecord_snr_reply AS reply " +
                "FROM CUSTOMRECORD_STICK_NOTE_REPLY r " +
                "WHERE r.isinactive = 'F' AND r.custrecord_snr_note IN (" + nids + ") " +
                "ORDER BY r.created DESC, r.id DESC";
            query.runSuiteQL({ query: rsql }).asMappedResults().forEach(function (rr) {
                var n = noteIndex[String(rr.note_id)];
                if (n) n.replies.push({ date: rr.created, msg: rr.reply || '' });
            });
        }

        return byOrder;
    }

    // ------------------------------------------------------------ writing

    /**
     * Confirms the target really is a sales order this dashboard covers, so a
     * crafted POST cannot attach a note to an arbitrary record id.
     * Returns { id, tranid, custName, custNum } or null.
     */
    function verifySalesOrder(soId) {
        if (!/^\d+$/.test(String(soId))) return null;

        var sql =
            "SELECT t.id, t.tranid, " +
            "  NVL(c.companyname, c.altname) AS cust_name, c.entityid AS cust_num " +
            "FROM transaction t " +
            "JOIN customer c ON c.id = t.entity " +
            "WHERE t.id = " + soId + " AND t.type = 'SalesOrd' " +
            "  AND " + statusIn('t.status', 'SalesOrd', SO_OPEN) + " " +
            "  AND EXISTS (SELECT 1 FROM transactionline tl WHERE tl.transaction = t.id " +
            "              AND tl.mainline = 'F' AND tl.location IN (" + SCOPE_SQL + ") " +
            "              AND tl.isclosed = 'F')";

        var r = query.runSuiteQL({ query: sql }).asMappedResults();
        if (!r.length) return null;
        return {
            id: r[0].id,
            tranid: r[0].tranid,
            custName: r[0].cust_name || '',
            custNum: r[0].cust_num || ''
        };
    }

    /**
     * Creates a StickyNotes note against a sales order.
     *
     * NOTE ON BUNDLE BEHAVIOUR: there is no User Event script deployed on
     * CUSTOMRECORD_STICK_NOTE, so nothing of the bundle's runs when we save this
     * record. It will store and display on the sales order exactly like any other
     * note, but any side effects the bundle's own backend Suitelet performs when
     * you create a note through its UI -- subscriber emails in particular -- will
     * NOT happen here. Treat a note written from this dashboard as visible, not
     * as delivered.
     */
    function createSticky(so, message, priority, isPublic, userId) {
        var rec = record.create({
            type: 'customrecord_stick_note',
            isDynamic: false
        });

        // The bundle stores line breaks as the literal token [br].
        var msg = String(message || '').replace(/\r\n|\r|\n/g, '[br]');

        rec.setValue({ fieldId: 'custrecord_sn_message', value: msg });
        rec.setValue({ fieldId: 'custrecord_sn_record_id', value: so.id });
        rec.setValue({
            fieldId: 'custrecord_sn_record_type_script_id',
            value: STICKY_NEW.recordTypeScriptId
        });
        rec.setValue({
            fieldId: 'custrecord_sn_scripted_record_type',
            value: STICKY_NEW.scriptedRecordType
        });
        rec.setValue({
            fieldId: 'custrecord_sn_record_name',
            value: 'Sales Order: ' + so.custNum + ' ' + so.custName
        });
        rec.setValue({ fieldId: 'custrecord_sn_note_category', value: priority });
        rec.setValue({ fieldId: 'custrecord_sn_is_public', value: isPublic });
        rec.setValue({ fieldId: 'custrecord_sn_status', value: STICKY_NEW.status });
        rec.setValue({ fieldId: 'custrecord_sn_z_index', value: STICKY_NEW.zIndex });
        rec.setValue({ fieldId: 'custrecord_sn_percent_top', value: STICKY_NEW.percentTop });
        rec.setValue({ fieldId: 'custrecord_sn_percent_left', value: STICKY_NEW.percentLeft });

        // Who may see it when private, and who the bundle treats as subscribed.
        if (userId) {
            rec.setValue({ fieldId: 'custrecord_sn_allowed_entities', value: String(userId) });
        }

        var id = rec.save({ ignoreMandatoryFields: true });

        // Owner drives the author shown on the note. If the deployment runs with
        // "execute as role = Administrator", the record would otherwise be owned
        // by Administrator rather than the person who wrote it. Owner is not
        // always settable, so this is best-effort and never blocks the save.
        if (userId) {
            try {
                record.submitFields({
                    type: 'customrecord_stick_note',
                    id: id,
                    values: { owner: userId },
                    options: { ignoreMandatoryFields: true }
                });
            } catch (ownerErr) {
                log.audit({
                    title: 'Sticky owner not settable',
                    details: 'note ' + id + ': ' + (ownerErr.message || ownerErr)
                });
            }
        }

        return id;
    }

    /**
     * POST endpoint for the composer. Returns JSON, not a page.
     *
     * This is the one place response.write() is correct: it is an AJAX data
     * endpoint, not the dashboard. The dashboard itself is still rendered only
     * through writePage(form) in the GET branch.
     */
    function handlePost(context) {
        var out = { ok: false, error: 'Unrecognised request' };

        try {
            var body = JSON.parse(context.request.body || '{}');
            var msg = String(body.message || '').trim();

            if (!msg) {
                out.error = 'Note text is required.';
            } else if (msg.length > 4000) {
                out.error = 'Note is too long (4000 character limit).';
            } else {
                var so = verifySalesOrder(body.soId);
                if (!so) {
                    out.error = 'That sales order is not an open order at this location.';
                } else {
                    var priority = [1, 2, 3].indexOf(Number(body.priority)) >= 0
                        ? Number(body.priority) : 2;
                    var isPublic = body.isPublic === false ? 'F' : 'T';
                    var userId = runtime.getCurrentUser().id;

                    var id = createSticky(so, msg, priority, isPublic, userId);
                    log.audit({
                        title: 'Sticky note created',
                        details: 'note ' + id + ' on ' + so.tranid + ' by user ' + userId
                    });
                    out = { ok: true, id: id, tranid: so.tranid };
                }
            }
        } catch (e) {
            log.error({ title: 'Sticky create failed', details: e });
            out = { ok: false, error: e.message || String(e) };
        }

        context.response.setHeader({ name: 'Content-Type', value: 'application/json' });
        context.response.write(JSON.stringify(out));
    }

    // --------------------------------------------------------- core analysis

    /**
     * Groups lines into orders, computes due dates, then allocates scarce supply
     * across orders in due-date order.
     *
     * The allocation pass is the whole point of this tool. max_buildable is a
     * per-item cached number that has no idea other orders exist, so three orders
     * for 100 units each will all show "buildable" against a pool of 42. Here the
     * pool is drawn down as it is consumed.
     */
    function buildModel(rows, woMap, stickyMap) {
        var today = new Date();
        today.setHours(0, 0, 0, 0);

        var orders = {};
        var lines = [];

        rows.forEach(function (r) {
            var soId = String(r.so_id);

            if (!orders[soId]) {
                var td = parseNsDate(r.tran_date);
                var lead = LEAD_DAYS.hasOwnProperty(r.cat_id)
                    ? LEAD_DAYS[r.cat_id]
                    : DEFAULT_LEAD_DAYS;
                var due = td ? addDays(td, lead) : null;
                var dueSource = 'derived';

                // OEM orders carry a real scheduled ship date on the mainline row,
                // so use it instead of trandate + category lead time. Everything
                // else has no such date and stays on the derived calculation.
                //
                // custbody_promisedate is deliberately NOT used: it is a rigid
                // trandate+4 on 119 of 122 OEM orders and has corrupt values on 3,
                // so it carries no real scheduling intent.
                // Shopify is a sales channel, so it wins over whatever category
                // the customer record happens to carry.
                // Plant is a separate axis now (the switch above the tabs), so
                // door orders get the same customer-type tabs as hitch orders.
                var tabKey = (Number(r.is_shopify) === 1)
                    ? 'RETAIL'
                    : tabForCategory(r.cat_id);
                if (tabKey === 'OEM') {
                    var actual = parseNsDate(r.exp_ship);
                    if (actual) {
                        due = actual;
                        dueSource = 'actual';
                    }
                }

                orders[soId] = {
                    id: r.so_id,
                    num: r.so_num,
                    tranDate: td,
                    dueDate: due,
                    dueSource: dueSource,
                    leadDays: lead,
                    catId: r.cat_id,
                    tab: tabKey,
                    isShopify: Number(r.is_shopify) === 1,
                    locId: Number(r.loc_id),
                    isCustom: false,
                    total: num(r.order_total),
                    daysLate: due ? daysBetween(due, today) : 0,
                    custNum: r.cust_num,
                    custName: r.cust_name || r.cust_num,
                    parentName: r.parent_name || '',
                    notes: r.order_notes || '',
                    stickies: [],
                    soStatus: r.so_status,
                    lines: []
                };
            }

            var line = {
                soId: soId,
                lineId: r.line_id,
                seq: r.line_seq,
                itemId: r.item_id,
                itemName: r.item_name,
                memo: r.line_memo || '',
                locId: Number(r.loc_id),
                qtyOpen: num(r.qty_open),
                maxBuild: num(r.max_build),
                qtyAvail: num(r.qty_avail),
                qtyOnHand: num(r.qty_onhand),
                fromStock: 0,
                fromBuild: 0,
                shortfall: 0,
                status: STATUS.BLOCKED,
                // Counts only at load time; the rows behind them are fetched
                // when someone opens the line.
                wo: woMap[String(r.item_id)] || null,
                comp: null      // component floor counts arrive via &wipstatus=1 after paint
            };

            if (Number(r.is_custom) === 1) orders[soId].isCustom = true;

            orders[soId].lines.push(line);
            lines.push(line);
        });

        // Sort lines by their order's due date so the most urgent order draws
        // from the shared pool first. Ties break on SO number for stability --
        // otherwise identical due dates would allocate in arbitrary query order.
        lines.sort(function (a, b) {
            var oa = orders[a.soId], ob = orders[b.soId];
            var da = oa.dueDate, db = ob.dueDate;
            if (da && db && da.getTime() !== db.getTime()) return da.getTime() - db.getTime();
            if (!da && db) return 1;
            if (da && !db) return -1;
            return String(oa.num).localeCompare(String(ob.num));
        });

        // Per-item supply pools, consumed as we walk the sorted lines.
        var stockPool = {};
        var buildPool = {};

        lines.forEach(function (ln) {
            // Stock is physical and sits at ONE plant, so the pool key includes
            // the location. Build capacity comes from custitem_gny_max_buildable,
            // which is calculated account-wide, so that pool stays per-item and is
            // shared across both plants.
            var sKey = ln.itemId + '@' + ln.locId;
            if (!stockPool.hasOwnProperty(sKey)) stockPool[sKey] = ln.qtyAvail;
            if (!buildPool.hasOwnProperty(ln.itemId)) buildPool[ln.itemId] = ln.maxBuild;

            var need = ln.qtyOpen;

            // Stock first -- a finished unit on the shelf beats build capacity.
            var takeStock = Math.min(need, stockPool[sKey]);
            stockPool[sKey] -= takeStock;
            ln.fromStock = takeStock;
            need -= takeStock;

            // Then build capacity, netted against everything already promised.
            var takeBuild = Math.min(need, buildPool[ln.itemId]);
            buildPool[ln.itemId] -= takeBuild;
            ln.fromBuild = takeBuild;
            need -= takeBuild;

            ln.shortfall = need;

            if (need <= 0) {
                ln.status = (ln.fromBuild > 0) ? STATUS.BUILD : STATUS.SHIP;
            } else if (ln.fromStock > 0 || ln.fromBuild > 0) {
                ln.status = STATUS.PARTIAL;
            } else if (ln.wo && ln.wo.woCount > 0) {
                // A traveler-printed work order for this exact item.
                ln.status = STATUS.WIP;
            } else {
                // Provisional. The client asks &wipstatus=1 for exactly these
                // short lines after first paint and upgrades any whose
                // components are on the floor to WIP in place. Only short lines
                // are worth asking about (~160 items instead of ~530), and the
                // lookup no longer blocks the page.
                ln.status = STATUS.BLOCKED;
            }
        });

        // Order rollup = worst line on the order.
        var list = [];
        Object.keys(orders).forEach(function (k) {
            var o = orders[k];
            o.stickies = (stickyMap && stickyMap[String(o.id)]) || [];
            var worst = STATUS.SHIP;
            var blocked = 0;
            o.lines.forEach(function (ln) {
                if (ln.status.rank > worst.rank) worst = ln.status;
                if (ln.status.rank >= STATUS.PARTIAL.rank) blocked++;
            });
            o.status = worst;
            o.blockedLines = blocked;
            list.push(o);
        });

        // Most urgent first.
        list.sort(function (a, b) {
            if (b.daysLate !== a.daysLate) return b.daysLate - a.daysLate;
            return String(a.num).localeCompare(String(b.num));
        });

        return list;
    }

