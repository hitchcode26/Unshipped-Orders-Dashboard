    /**
     * Line table for the drill-down.
     *
     * The supply meter is the point of this view: one proportional bar per line
     * showing how the demand is covered -- green from stock on the shelf, blue
     * from remaining build capacity, red not covered at all. Because capacity is
     * netted across orders before this renders, a red segment means the parts are
     * genuinely spoken for by an earlier-due order, not merely "low".
     */
    function renderLineTable(o) {
        var h = '<table class="inner"><tr>' +
            '<th>Item</th><th>Need</th><th>Coverage</th>' +
            '<th>On hand</th><th>Max build</th><th>Printed WOs</th><th>Status</th>' +
            '</tr>';

        o.lines.forEach(function (ln) {
            var total = ln.qtyOpen || 1;
            var pStock = Math.round((ln.fromStock / total) * 100);
            var pBuild = Math.round((ln.fromBuild / total) * 100);
            var pShort = Math.max(0, 100 - pStock - pBuild);

            var meter = '<div class="meter" title="' +
                ln.fromStock + ' from stock, ' + ln.fromBuild + ' to build, ' +
                ln.shortfall + ' short">' +
                (pStock ? '<span class="m-stock" style="width:' + pStock + '%"></span>' : '') +
                (pBuild ? '<span class="m-build" style="width:' + pBuild + '%"></span>' : '') +
                (pShort ? '<span class="m-short" style="width:' + pShort + '%"></span>' : '') +
                '</div>';

            // Only name the segments that actually exist -- a key listing zeroes
            // is noise on a board people scan quickly.
            var parts = [];
            if (ln.fromStock) parts.push('<b>' + ln.fromStock + '</b> stock');
            if (ln.fromBuild) parts.push('<b>' + ln.fromBuild + '</b> build');
            if (ln.shortfall) parts.push('<b style="color:#b3241f">' + ln.shortfall + '</b> short');
            var key = '<div class="mkey">' + (parts.join(' &middot; ') || '&mdash;') + '</div>';

            var woTxt = (ln.wo && ln.wo.qty > 0)
                ? '<span class="wocell">' + ln.wo.qty + ' pcs' +
                  '<span class="muted"> / ' + ln.wo.count + ' WO' + (ln.wo.count > 1 ? 's' : '') + '</span></span>'
                : '<span class="wonone">none</span>';

            h += '<tr class="c-' + ln.status.key + '">' +
                '<td><a class="item" href="' + itemUrl(ln.itemId) + '" target="_blank">' +
                    esc(ln.itemName) + '</a></td>' +
                '<td class="num">' + ln.qtyOpen + '</td>' +
                '<td>' + meter + key + '</td>' +
                '<td class="num">' + ln.qtyAvail + '</td>' +
                '<td class="num">' + ln.maxBuild + '</td>' +
                '<td>' + woTxt + '</td>' +
                '<td><span class="pill ' + ln.status.css + '">' + ln.status.label + '</span></td>' +
                '</tr>';

            if (ln.memo) {
                h += '<tr><td colspan="7" class="linememo">' + esc(ln.memo) + '</td></tr>';
            }
        });

        return h + '</table>';
    }

    /**
     * Returns an HTML FRAGMENT (no <html>/<body>) wrapped in #gyh-bo, suitable
     * for an INLINEHTML field.
     */
    function renderFragment(orders) {
        var counts = { SHIP: 0, BUILD: 0, PARTIAL: 0, WO: 0, BLOCKED: 0 };
        var lateCt = 0;
        orders.forEach(function (o) {
            counts[o.status.key]++;
            if (o.daysLate > 0) lateCt++;
        });

        var h = renderStyles();
        h += '<div id="' + WRAP + '">';

        // Tab bar. Counts are per-tab so each reads as its own report.
        var tabCounts = {};
        orders.forEach(function (o) { tabCounts[o.tab] = (tabCounts[o.tab] || 0) + 1; });

        var activeTab = null;
        var visibleTabs = TABS.filter(function (t) {
            return !t.onlyIfPopulated || (tabCounts[t.key] || 0) > 0;
        });
        visibleTabs.forEach(function (t) {
            if (!activeTab && (tabCounts[t.key] || 0) > 0) activeTab = t.key;
        });
        if (!activeTab && visibleTabs.length) activeTab = visibleTabs[0].key;

        h += '<div class="tabs">';
        visibleTabs.forEach(function (t) {
            h += '<div class="tab' + (t.key === activeTab ? ' on' : '') +
                 (t.key === 'UNASSIGNED' ? ' warnTab' : '') +
                 '" data-tab="' + t.key + '" tabindex="0">' + esc(t.label) +
                 '<span class="tc">' + (tabCounts[t.key] || 0) + '</span></div>';
        });
        h += '<span class="asof">GEN-Y HITCH &middot; as of ' + fmtDate(new Date()) + '</span>';
        h += '</div>';

        // Signal chips double as the status filter -- clicking one is the same as
        // choosing it from a dropdown, which is the action people actually want
        // after reading the number.
        var SIGS = [
            { k: 'TOTAL',   label: 'Orders',    cls: '',          filter: ''        },
            { k: 'LATE',    label: 'Past due',  cls: 'c-BLOCKED', filter: '__LATE__' },
            { k: 'SHIP',    label: 'Ship now',  cls: 'c-SHIP',    filter: 'SHIP'    },
            { k: 'BUILD',   label: 'Build now', cls: 'c-BUILD',   filter: 'BUILD'   },
            { k: 'PARTIAL', label: 'Partial',   cls: 'c-PARTIAL', filter: 'PARTIAL' },
            { k: 'WO',      label: 'On a WO',   cls: 'c-WO',      filter: 'WO'      },
            { k: 'BLOCKED', label: 'Blocked',   cls: 'c-BLOCKED', filter: 'BLOCKED' }
        ];

        h += '<div class="signals">';
        SIGS.forEach(function (g) {
            h += '<div class="sig ' + g.cls + '" data-filter="' + g.filter + '" tabindex="0">' +
                 '<div class="v num" data-stat="' + g.k + '">0</div>' +
                 '<div class="k">' + (g.cls ? '<span class="dot"></span>' : '') + esc(g.label) + '</div>' +
                 '</div>';
        });
        h += '</div>';

        h += '<div class="bar">' +
            '<input id="' + WRAP + '-q" type="text" placeholder="Search order, customer, item or note">' +
            '<label class="chk"><input id="' + WRAP + '-late" type="checkbox"> <span>Past due only</span></label>' +
            '<button type="button" class="clear" id="' + WRAP + '-clear">Reset filters</button>' +
            '<select id="' + WRAP + '-st" style="display:none"><option value=""></option>' +
            '<option value="SHIP"></option><option value="BUILD"></option>' +
            '<option value="PARTIAL"></option><option value="WO"></option>' +
            '<option value="BLOCKED"></option></select>' +
            '<span class="spacer">Showing <b id="' + WRAP + '-cnt" class="num">' + orders.length + '</b></span>' +
            '</div>';

        h += '<table class="grid"><tr>' +
            '<th style="width:4px;padding:0"></th>' +
            '<th style="width:16px"></th><th>Order</th><th>Customer</th><th>Ordered</th>' +
            '<th>Due</th><th>Late</th><th>Lines</th><th>Status</th><th>Order notes</th>' +
            '</tr>';

        orders.forEach(function (o) {
            var search = (String(o.num) + ' ' + o.custName + ' ' + o.parentName + ' ' + o.custNum + ' ' + o.notes + ' ' +
                          o.lines.map(function (l) { return l.itemName; }).join(' ')).toLowerCase();

            // Severity band for days late: 0 / 1-7 / 8-30 / 30+. Encodes how bad,
            // not just that it is bad.
            var lateCls = o.daysLate <= 0 ? 'l0'
                        : o.daysLate <= 7 ? 'l1'
                        : o.daysLate <= 30 ? 'l2' : 'l3';

            h += '<tr class="ord c-' + o.status.key + '" data-id="' + o.id + '" data-st="' + o.status.key + '" ' +
                 'data-tab="' + o.tab + '" ' +
                 'data-late="' + (o.daysLate > 0 ? '1' : '0') + '" ' +
                 'data-search="' + esc(search) + '">' +
                '<td class="edge"><span class="edgebar"></span></td>' +
                '<td><span class="caret" data-for="' + o.id + '">&#9654;</span></td>' +
                '<td><a class="so" href="' + soUrl(o.id) + '" target="_blank">' + esc(o.num) + '</a></td>' +
                '<td><div class="cust">' + esc(o.custName) + '</div>' +
                    '<div class="muted">' +
                    (o.parentName ? esc(o.parentName) + ' &middot; ' : '') +
                    esc(o.custNum) + '</div></td>' +
                '<td class="num">' + fmtDate(o.tranDate) + '</td>' +
                '<td class="num">' + fmtDate(o.dueDate) +
                    (o.dueSource === 'actual'
                        ? '<div class="dueact" title="Scheduled ship date from the order">scheduled</div>'
                        : '<div class="muted">+' + o.leadDays + 'd lead</div>') + '</td>' +
                '<td class="num"><span class="late ' + lateCls + '">' +
                    (o.daysLate > 0 ? o.daysLate : '&mdash;') + '</span></td>' +
                '<td class="num">' + o.lines.length +
                    (o.blockedLines ? ' <span class="muted" style="color:#b3241f">' +
                     o.blockedLines + ' short</span>' : '') + '</td>' +
                '<td><span class="pill ' + o.status.css + '">' + o.status.label + '</span></td>' +
                '<td class="notecell">' +
                    (o.notes
                        ? '<span class="noteflag" title="' + esc(o.notes) + '">' +
                          esc(clip(o.notes, 90)) + '</span>'
                        : '<span class="nonote">&mdash;</span>') +
                '</td>' +
                '</tr>';

            h += '<tr class="det" data-for="' + o.id + '"><td colspan="10"><div class="drill">';
            if (o.notes) {
                h += '<div class="notes"><b>Sales team notes</b>' + esc(o.notes) + '</div>';
            }
            h += renderLineTable(o);
            h += '</div></td></tr>';
        });

        h += '</table>';
        h += '<div class="empty" id="' + WRAP + '-empty" style="display:none">' +
             '<div class="big">Nothing matches</div>' +
             'Clear the search or pick a different signal above.</div>';
        h += '</div>';          // close #gyh-bo
        h += renderScript();    // runs after the wrapper exists in the DOM

        return h;
    }

    // -------------------------------------------------------------- entry pt

    function onRequest(context) {
        if (context.request.method !== 'GET') return;

        var form = serverWidget.createForm({ title: 'Buildable Orders' });

        var fld = form.addField({
            id: 'custpage_gyh_bo_html',
            type: serverWidget.FieldType.INLINEHTML,
            label: ' '
        });

        // Full page width: no column, sits below any field group.
        fld.updateLayoutType({ layoutType: serverWidget.FieldLayoutType.OUTSIDEBELOW });
        fld.updateBreakType({ breakType: serverWidget.FieldBreakType.STARTROW });

        try {
            var user = runtime.getCurrentUser();
            var ctxInfo = 'user ' + user.id + ' / role ' + user.role +
                          ' / subsidiary ' + user.subsidiary +
                          ' / script ' + runtime.getCurrentScript().id;
            log.audit({ title: 'GYH_BuildableOrders_SL start', details: ctxInfo });

            if (context.request.parameters.debug === 'T') {
                fld.defaultValue = renderDebug(runProbes(), ctxInfo);
                context.response.writePage(form);
                return;
            }

            var rows = fetchOpenLines();
            log.audit({ title: 'fetchOpenLines', details: 'rows=' + (rows ? rows.length : 'null') });

            var woMap = fetchPrintedWos();
            log.audit({ title: 'fetchPrintedWos', details: 'items=' + Object.keys(woMap).length });

            var orders = buildModel(rows, woMap);
            log.audit({ title: 'buildModel', details: 'orders=' + orders.length });

            if (!rows || rows.length === 0) {
                log.error({
                    title: 'Query returned zero rows',
                    details: 'Same SQL returns 476 rows via an integration role. ' +
                             'Add &debug=T to the URL to isolate which filter or table is blocked.'
                });
            }

            fld.defaultValue = renderFragment(orders);
        } catch (e) {
            log.error({ title: 'GYH_BuildableOrders_SL failed', details: e });
            fld.defaultValue =
                '<div id="' + WRAP + '" style="font-family:Arial;padding:16px">' +
                '<div style="color:#9a1c1c;font-size:15px;font-weight:bold">Report failed to run</div>' +
                '<p>' + esc(e.message || e) + '</p>' +
                '<pre style="background:#f4f4f4;padding:12px;font-size:11px;white-space:pre-wrap">' +
                esc(e.stack || '') + '</pre></div>';
        }

        // writePage keeps the NetSuite header, role switcher and navigation.
        context.response.writePage(form);
    }

    return { onRequest: onRequest };
});
